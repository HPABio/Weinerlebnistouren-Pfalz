---
import Layout from "@/layouts/main.astro";
import { Image } from "astro:assets";
import CompressedMjVineYardV1 from "@images/compressed/webP/compressed-mj-vineYard-V1.webp";
import BrigittaHeylPortrait from "@images/BrigittaHeylPortrait.png";
import CompressedMjGrapesMosaicGlass from "@images/compressed/webP/compressed-mj-grapes-mosaicGlass.webp";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import partnerWeingüterData from "@/assets/Info_PartnerWeingüter/partnerWeingüter.json";

// Import images for partner Weingüter
import FerckelImage from "@/assets/Info_PartnerWeingüter/Ferckel/IMG_4469.jpg";
import KlohrImage from "@/assets/Info_PartnerWeingüter/Heinrich_Klohr/IMG_4854.jpeg";
import BuchertImage from "@/assets/Info_PartnerWeingüter/Buchert/buchert-bild_c-mel-hubach.jpg";
import EdgarKlohrImage from "@/assets/Info_PartnerWeingüter/Edgar_Klohr/Weingut_Edgar_Klohr_1.jpeg";
import AltesSteigelmannImage from "@/assets/Info_PartnerWeingüter/Altes_Weingut_Steigelmann/20240824_152239.jpg";
import BaehrImage from "@/assets/Info_PartnerWeingüter/Baehr/Seccoparty.jpg";

const partnerWeingüter = partnerWeingüterData.partnerWeingüter;
const ferckel = partnerWeingüter.find((w) => w.id === "ferckel");
const klohr = partnerWeingüter.find((w) => w.id === "heinrich-klohr");
const buchert = partnerWeingüter.find((w) => w.id === "buchert");
const edgarKlohr = partnerWeingüter.find((w) => w.id === "edgar-klohr");
const altesSteigelmann = partnerWeingüter.find(
  (w) => w.id === "altes-weingut-steigelmann"
);
const baehr = partnerWeingüter.find((w) => w.id === "baehr");
---

<Layout
  content={{
    title: "Unsere Partner-Weingüter - Heyl Weintouren",
    description:
      "Entdecken Sie die besten Weingüter der Pfalz - von traditionellen Familienbetrieben bis hin zu modernen Weingütern mit alkoholfreien Alternativen.",
  }}>
  <Header isHome={false} />

  <main class="min-h-screen bg-gradient-to-b from-background to-soft-sand">
    <!-- Hero Section with Personal Touch -->
    <section class="relative py-20 overflow-hidden">
      <!-- Background Image -->
      <div class="absolute inset-0 z-0">
        <Image
          src={CompressedMjVineYardV1}
          alt="Weinberge der Pfalz"
          class="w-full h-full object-cover opacity-20"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-background to-soft-sand/20 opacity-70">
        </div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <div class="mb-8">
            <Image
              src={BrigittaHeylPortrait}
              alt="Brigitta Heyl"
              class="w-24 h-24 object-cover object-top rounded-full mx-auto border-4 border-accent1 shadow-lg"
            />
          </div>
          <h1 class="text-5xl md:text-6xl font-headline text-text mb-6">
            Unsere Partner-Weingüter
          </h1>
          <p
            class="text-xl md:text-2xl text-text/80 max-w-4xl mx-auto mb-8 font-body leading-relaxed">
            Als Ihre persönliche Weinführerin der Pfalz stelle ich Ihnen meine
            sorgfältig ausgewählten Partner-Weingüter vor. Jedes Weingut hat
            seine eigene Geschichte und Tradition, die ich Ihnen gerne näher
            bringe.
          </p>
          <div
            class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <div class="flex items-center gap-2 text-accent2-plum">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="font-semibold">Persönlich ausgewählt</span>
            </div>
            <div class="flex items-center gap-2 text-accent2-plum">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="font-semibold">Alkoholfreie Alternativen</span>
            </div>
            <div class="flex items-center gap-2 text-accent2-plum">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="font-semibold">Tradition & Innovation</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Personal Introduction Section -->
    <section class="py-16 bg-white/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-2xl shadow-lg p-8 md:p-12">
          <div class="flex flex-col md:flex-row items-center gap-8">
            <div class="flex-shrink-0">
              <Image
                src={CompressedMjGrapesMosaicGlass}
                alt="Weintrauben"
                class="w-32 h-32 rounded-full object-cover border-4 border-accent1"
              />
            </div>
            <div class="text-center md:text-left">
              <h2 class="text-3xl font-headline text-text mb-4">
                Meine persönliche Auswahl
              </h2>
              <p class="text-lg text-text/80 leading-relaxed font-body">
                Über die Jahre habe ich enge Beziehungen zu den
                außergewöhnlichen Weingütern der Region aufgebaut. Jedes Weingut
                in dieser Liste habe ich persönlich besucht und kennengelernt.
                Sie alle teilen meine Leidenschaft für Qualität, Tradition und
                die besondere Atmosphäre der Pfalz.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>


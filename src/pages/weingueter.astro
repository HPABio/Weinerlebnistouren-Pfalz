                  Gimmeldingen
                </span>
              </div>
              <div class="mb-4">
                <Image
                  src={CompressedMjVineYardV1}
                  alt="Weingut Estelmann"
                  class="w-full h-48 object-cover rounded-lg mb-4"
                />
              </div>
              <h3 class="text-xl font-headline text-text mb-3">
                Weingut Estelmann
              </h3>
              <p class="text-text/70 mb-2 font-body">Kurpfalzstr. 76</p>
              <p class="text-text/70 mb-4 font-body">Tel. 06321 6173</p>

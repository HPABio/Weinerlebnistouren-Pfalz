---
// src/pages/tours.astro
import Layout from "@/layouts/main.astro";
import InteractiveTours from "@/components/ToursPageComponents/InteractiveTours";
import InteractiveToursIV from "@/components/ToursPageComponents/InteractiveToursIV";
import InteractiveToursVertical from "@/components/ToursPageComponents/InteractiveToursVertical";
import InteractiveToursMobile from "@/components/ToursPageComponents/InteractiveTours-mobile";
import InteractiveToursMobileV2 from "@/components/ToursPageComponents/InteractiveTours-mobileV2";
import ScreenSizeDEVTOOL from "@/components/ScreenSizeDEVTOOL.astro";
import ToursV2 from "@/components/ToursPageComponents/ToursV2.astro";
import ImageGalleryToursAstro from "@/components/ImageGalleryToursAstro.astro";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

import MJAlmondFlowerV1 from "@images/compressed/webP/compressed-mj-almondFlowerV1.webp";
import MJAlmondFlowerMosaicGlass from "@images/compressed/webP/compressed-mj-almondFlower-mosaicGlass.webp";
import MJBachusMosaicGlass from "@images/compressed/webP/compressed-mj-Bachus-mosaicGlass.webp";
import MJGlühweinV1 from "@images/compressed/webP/compressed-mj-GlühweinV1.webp";
import MJWallWithGrapes from "@images/compressed/webP/compressed-mj-wallWithGrapes.webp";
import MJGlühweinV2 from "@images/compressed/webP/compressed-mj-GlühweinV2.webp";
import WassermühleImWald from "@images/compressed/webP/compressed-Wassermühle-im-Wald.png";
import GetInTouch from "@/components/InfoCards/GetInTouchCard.astro";

const images = {
  MJAlmondFlowerV1,
  MJAlmondFlowerMosaicGlass,
  MJBachusMosaicGlass,
  MJGlühweinV1,
  MJWallWithGrapes,
  MJGlühweinV2,
  WassermühleImWald,
};
// Note: Tour parameter is now read directly in the React component
---

<Layout content={{ title: "Unsere Touren" }}>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={MJAlmondFlowerMosaicGlass.src}
  />

  <!-- <ScreenSizeDEVTOOL /> -->
  <!-- Development Navigation Buttons -->
  <Header isDarkMode={false} isTours={true} />

  <!-- mobile only -->
  <h1
    class="text-center text-2xl font-bold sm:hidden h-[20vh] mt-20 items-center justify-center hidden">
    🚧 ATTENTION 🚧 <br /> The mobile version of this page is not available at this
    moment
  </h1>
  <InteractiveToursMobile
    client:load
    images={images}
    backgroundImage={MJWallWithGrapes}
    className="block sm:hidden"
  />
  <!-- <InteractiveToursMobileV2 client:load images={images} backgroundImage={MJWallWithGrapes} className="md:hidden" /> 	 -->

  <!-- SM Screens and bigger -->
  <!-- <InteractiveTours client:load images={images} backgroundImage={MJWallWithGrapes} className="hidden sm:block" /> -->
  <InteractiveToursIV
    client:load
    images={images}
    backgroundImage={MJWallWithGrapes}
    className="hidden sm:block"
  />
  <!-- <InteractiveToursVertical client:load images={images} backgroundImage={MJWallWithGrapes} className="hidden md:block" /> -->

  <!-- Image Gallery Section -->
  <ImageGalleryToursAstro
    numberOfImages={12}
    className="bg-stone-50 max-w-lg sm:max-w-xl lg:max-w-3xl 2xl:max-w-5xl mx-auto mt-10"
  />

  <!-- <GetInTouch className="hidden md:block -mt-[600px]  bg-gradient-to-t from-stone-100 to-transparent" /> -->
  <GetInTouch
    className="hidden md:block bg-gradient-to-t from-stone-100 to-transparent mt-10 pb-12"
  />
  <Footer />
</Layout>

---

<MainLayout content={{ title: "Design System & Visual Language - Weinerlebnistouren Pfalz", description: "Offizielle Design-Richtlinien, Typografie-Katalog, Farbtokens und UI-Komponenten von Weinerlebnistouren Pfalz." }}>
  <Header isHome={false} />

  <main class="min-h-screen bg-[#F4F0E6] text-[#4B3A2B] pb-24 selection:bg-[#C8A974] selection:text-white">
    <!-- Hero / Cover Banner -->
    <section class="relative overflow-hidden bg-gradient-to-b from-[#55354E] via-[#8A2D52] to-[#4B3A2B] text-stone-50 py-20 px-4 sm:px-8 md:px-16 shadow-2xl">
      <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#C8A974_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>
      
      <div class="max-w-7xl mx-auto relative z-10">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs font-medium tracking-widest uppercase text-[#C8A974] mb-4">
              <span class="w-2 h-2 rounded-full bg-[#C8A974] animate-pulse"></span>
              Corporate Design & Brand Architecture
            </div>
            <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold font-headline tracking-tight leading-tight">
              Design Language
            </h1>
            <p class="mt-3 text-[#C8A974] font-accent text-3xl sm:text-4xl md:text-5xl">
              Weinerlebnistouren Pfalz
            </p>
            <p class="mt-4 max-w-2xl text-stone-200 font-body text-lg sm:text-xl leading-relaxed">
              Ein umfassendes Visuelles System & Typografie-Katalog. Alle Design-Tokens, Farbwerte, Form-Radien und verfügbaren Schriftarten im Überblick.
            </p>
          </div>

          <!-- Quick Stats Badges -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 bg-white/10 backdrop-blur-md p-4 rounded-2xl border border-white/15">
            <div class="text-center p-2">
              <div class="text-3xl font-bold font-bonanova text-[#C8A974]">18</div>
              <div class="text-[11px] uppercase tracking-wider text-stone-300">Schriftarten</div>
            </div>
            <div class="text-center p-2 border-l border-white/10">
              <div class="text-3xl font-bold font-bonanova text-[#C8A974]">8</div>
              <div class="text-[11px] uppercase tracking-wider text-stone-300">Brand Farbtöne</div>
            </div>
            <div class="text-center p-2 border-l border-white/10">
              <div class="text-3xl font-bold font-bonanova text-[#C8A974]">8</div>
              <div class="text-[11px] uppercase tracking-wider text-stone-300">Form-Radien</div>
            </div>
            <div class="text-center p-2 border-l border-white/10">
              <div class="text-3xl font-bold font-bonanova text-[#C8A974]">100%</div>
              <div class="text-[11px] uppercase tracking-wider text-stone-300">Responsive</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sticky Navigation Bar -->
    <nav class="sticky top-[70px] z-40 bg-[#F4F0E6]/90 backdrop-blur-md border-b border-[#4B3A2B]/10 shadow-sm py-3 px-4 sm:px-8">
      <div class="max-w-7xl mx-auto flex items-center justify-between gap-4 overflow-x-auto no-scrollbar text-xs font-semibold uppercase tracking-wider">
        <a href="#typography" class="px-4 py-2 rounded-full bg-[#4B3A2B] text-white hover:bg-[#8A2D52] transition shrink-0">
          Typografie ({fontCatalog.length} Fonts)
        </a>
        <a href="#interactive-sandbox" class="px-4 py-2 rounded-full bg-white border border-[#4B3A2B]/15 hover:border-[#C8A974] text-[#4B3A2B] transition shrink-0">
          Font Playground
        </a>
        <a href="#colors" class="px-4 py-2 rounded-full bg-white border border-[#4B3A2B]/15 hover:border-[#C8A974] text-[#4B3A2B] transition shrink-0">
          Farbsystem
        </a>
        <a href="#shapes" class="px-4 py-2 rounded-full bg-white border border-[#4B3A2B]/15 hover:border-[#C8A974] text-[#4B3A2B] transition shrink-0">
          Radien & Form
        </a>
        <a href="#elevation" class="px-4 py-2 rounded-full bg-white border border-[#4B3A2B]/15 hover:border-[#C8A974] text-[#4B3A2B] transition shrink-0">
          Schatten & Tiefe
        </a>
        <a href="#components" class="px-4 py-2 rounded-full bg-white border border-[#4B3A2B]/15 hover:border-[#C8A974] text-[#4B3A2B] transition shrink-0">
          UI Komponenten
        </a>
      </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 mt-12 space-y-24">

      <!-- SECTION 1: TYPOGRAPHY SYSTEM & FONT SPECIMEN CATALOG -->
      <section id="typography" class="scroll-mt-32">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4 border-b border-[#4B3A2B]/15 pb-6">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-[#C8A974]">Katalog & Specimen</span>
            <h2 class="text-3xl sm:text-5xl font-headline font-bold text-[#4B3A2B] mt-1">
              Typografie & Schriftarten
            </h2>
            <p class="text-stone-600 font-body text-lg mt-2 max-w-3xl">
              Visualisierung aller im System verfügbaren Schriftarten in kleinen, mittleren und großen Konfigurationen – inklusive Alphabete, Schnitte und Tailwind-Klassen.
            </p>
          </div>

          <!-- Category Filter Bar -->
          <div class="flex items-center gap-2 overflow-x-auto py-1">
            <button id="filter-all" class="font-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#4B3A2B] text-white">Alle ({fontCatalog.length})</button>
            <button id="filter-serif" class="font-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-white border border-[#4B3A2B]/15 text-[#4B3A2B] hover:bg-stone-100">Serif</button>
            <button id="filter-cursive" class="font-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-white border border-[#4B3A2B]/15 text-[#4B3A2B] hover:bg-stone-100">Cursive</button>
            <button id="filter-sans" class="font-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-white border border-[#4B3A2B]/15 text-[#4B3A2B] hover:bg-stone-100">Sans-Serif</button>
          </div>
        </div>

        <!-- Font Specimen Grid -->
        <div class="grid grid-cols-1 gap-10">
          {fontCatalog.map((font, idx) => (
            <article 
              data-category={font.category}
              class="font-card bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-[#4B3A2B]/10 hover:shadow-xl transition-all duration-300 relative overflow-hidden group"
            >
              <!-- Top Header Row -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-stone-100 gap-3">
                <div class="flex items-center gap-3">
                  <span class="w-8 h-8 rounded-full bg-[#55354E] text-[#C8A974] flex items-center justify-center font-bold text-xs">
                    {idx + 1}
                  </span>
                  <div>
                    <h3 class="text-2xl font-bold font-bonanova text-[#4B3A2B] group-hover:text-[#8A2D52] transition">
                      {font.name}
                    </h3>
                    <p class="text-xs text-stone-500 font-sans mt-0.5">{font.usage}</p>
                  </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                  <span class={`px-2.5 py-1 rounded-md text-xs font-semibold border ${font.badgeColor}`}>
                    {font.category}
                  </span>
                  <code class="px-3 py-1 bg-stone-100 text-stone-700 font-mono text-xs rounded-md border border-stone-200 select-all">
                    {font.tailwindClass}
                  </code>
                </div>
              </div>

              <!-- Main Font Display Section (Large, Medium, Small) -->
              <div class="py-6 space-y-6">
                <!-- Large Display Specimen -->
                <div class="bg-stone-50/60 p-4 sm:p-6 rounded-xl border border-stone-100">
                  <div class="flex items-center justify-between text-[11px] font-mono uppercase text-stone-400 mb-2 tracking-wider">
                    <span>Große Konfiguration (Display / Hero Headline • ~48px–60px)</span>
                    <span>text-4xl md:text-6xl</span>
                  </div>
                  <div class={`${font.tailwindClass} text-3xl sm:text-5xl lg:text-6xl text-[#4B3A2B] leading-tight tracking-tight break-words`}>
                    {font.largeText}
                  </div>
                </div>

                <!-- Medium Subheading Specimen -->
                <div class="bg-stone-50/60 p-4 sm:p-6 rounded-xl border border-stone-100">
                  <div class="flex items-center justify-between text-[11px] font-mono uppercase text-stone-400 mb-2 tracking-wider">
                    <span>Mittlere Konfiguration (Subheading / Section Title • ~24px–32px)</span>
                    <span>text-xl md:text-3xl</span>
                  </div>
                  <div class={`${font.tailwindClass} text-xl sm:text-2xl md:text-3xl text-[#55354E] leading-snug font-medium`}>
                    {font.mediumText}
                  </div>
                </div>

                <!-- Small Body & Paragraph Specimen -->
                <div class="bg-stone-50/60 p-4 sm:p-6 rounded-xl border border-stone-100">
                  <div class="flex items-center justify-between text-[11px] font-mono uppercase text-stone-400 mb-2 tracking-wider">
                    <span>Kleine Konfiguration (Fließtext / Body / Beschreibung • ~14px–16px)</span>
                    <span>text-sm md:text-base</span>
                  </div>
                  <div class={`${font.tailwindClass} text-sm sm:text-base text-[#4B3A2B]/85 leading-relaxed`}>
                    {font.smallText}
                  </div>
                </div>
              </div>

              <!-- Full Character Set & Quick Copy Footer -->
              <div class="pt-4 border-t border-stone-100 flex flex-col md:flex-row md:items-center justify-between gap-4 text-xs">

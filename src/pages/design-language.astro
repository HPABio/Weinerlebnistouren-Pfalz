<!-- Client-side Interactive Script -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Font Category Filtering
    const filterBtns = document.querySelectorAll('.font-filter-btn');
    const fontCards = document.querySelectorAll('.font-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Active state update
        filterBtns.forEach(b => {
          b.classList.remove('bg-[#4B3A2B]', 'text-white');
          b.classList.add('bg-white', 'text-[#4B3A2B]');
        });
        btn.classList.remove('bg-white', 'text-[#4B3A2B]');
        btn.classList.add('bg-[#4B3A2B]', 'text-white');

        const category = btn.id.replace('filter-', '');
        fontCards.forEach(card => {
          const cardCat = card.getAttribute('data-category').toLowerCase();
          if (category === 'all' || cardCat.includes(category)) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // 2. Interactive Font Playground Controls
    const fontSelect = document.getElementById('font-select');
    const sizeSlider = document.getElementById('size-slider');
    const sizeValue = document.getElementById('size-value');
    const weightSelect = document.getElementById('weight-select');
    const customTextInput = document.getElementById('custom-text-input');
    const playgroundText = document.getElementById('playground-text');
    const playgroundOutput = document.getElementById('playground-output');
    const bgLightBtn = document.getElementById('bg-light-btn');
    const bgDarkBtn = document.getElementById('bg-dark-btn');

    let currentFontClass = fontSelect ? fontSelect.value : 'font-headline';

    function updatePlayground() {
      if (!playgroundText) return;
      
      // Update text content
      playgroundText.textContent = customTextInput.value || 'Weinerlebnistouren Pfalz';

      // Remove existing font family classes
      playgroundText.className = playgroundText.className
        .split(' ')
        .filter(c => !c.startsWith('font-'))
        .join(' ');

      // Add selected font family and weight
      playgroundText.classList.add(fontSelect.value, weightSelect.value);

      // Update font size
      const size = sizeSlider.value + 'px';
      playgroundText.style.fontSize = size;
      if (sizeValue) sizeValue.textContent = size;
    }

    if (fontSelect) fontSelect.addEventListener('change', updatePlayground);
    if (sizeSlider) sizeSlider.addEventListener('input', updatePlayground);
    if (weightSelect) weightSelect.addEventListener('change', updatePlayground);
    if (customTextInput) customTextInput.addEventListener('input', updatePlayground);

    // Theme toggle in playground
    if (bgLightBtn && bgDarkBtn && playgroundOutput) {
      bgLightBtn.addEventListener('click', () => {
        playgroundOutput.className = "min-h-[220px] p-8 rounded-2xl bg-[#F4F0E6] text-[#4B3A2B] border border-stone-300 flex items-center justify-center text-center transition-all duration-300 overflow-hidden shadow-inner";
        bgLightBtn.className = "flex-1 py-1.5 text-xs font-semibold bg-[#4B3A2B] text-white";
        bgDarkBtn.className = "flex-1 py-1.5 text-xs font-semibold bg-stone-100 text-stone-700 hover:bg-stone-200";
      });

      bgDarkBtn.addEventListener('click', () => {
        playgroundOutput.className = "min-h-[220px] p-8 rounded-2xl bg-[#55354E] text-[#F4F0E6] border border-[#8A2D52] flex items-center justify-center text-center transition-all duration-300 overflow-hidden shadow-inner";
        bgDarkBtn.className = "flex-1 py-1.5 text-xs font-semibold bg-[#8A2D52] text-white";
        bgLightBtn.className = "flex-1 py-1.5 text-xs font-semibold bg-stone-100 text-stone-700 hover:bg-stone-200";
      });
    }

    // 3. Copy to Clipboard
    const copyBtns = document.querySelectorAll('.copy-btn');
    copyBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const textToCopy = btn.getAttribute('data-copy');
        if (textToCopy) {
          navigator.clipboard.writeText(textToCopy);
          const originalHTML = btn.innerHTML;
          btn.innerHTML = '✓ Kopiert!';
          btn.classList.add('bg-emerald-600', 'text-white');
          setTimeout(() => {
            btn.innerHTML = originalHTML;
            btn.classList.remove('bg-emerald-600', 'text-white');
          }, 2000);
        }
      });
    });
  });
</script>

---
import Layout from "@/layouts/main.astro";
import { Image } from "astro:assets";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ScreenSizeDEVTOOL from "@/components/ScreenSizeDEVTOOL.astro";
import GimmeldingenMap from "@images/GimmeldingenMap.jpg"; //src/assets/images/GimmeldingenMap.jpg
import GeminiBusinessTrip from "@images/Gemini-Business-Trip.jpeg";
import CompressedMjVineYardColorPencilSketch from "@images/compressed/webP/compressed-mj-vineYard-ColorPencilSketch.webp";
import OnSitePhotosGruppenfotoBeiSteigelmanns from "@images/onSitePhotos/Gruppenfoto_bei_Steigelmanns.jpeg";
import GeminiTravelBus from "@images/Gemini-Travel-Bus.jpeg";
import BookingCard from "@/components/InfoCards/BookingCard.astro";
import GetInTouch from "@/components/InfoCards/GetInTouchCard.astro";
import HWELogoV2noText from "@images/HWE-LogoV2-noText.svg";
import GroupDescriptionOverview from "@/components/GroupDescriptionOverview.astro";
import GroupDescriptionOverviewV2 from "@/components/GroupDescriptionOverview-V2.astro";
import GroupDescriptionOverviewV3 from "@/components/GroupDescriptionOverview-V3.astro";
import GroupDescriptionOverviewV4 from "@/components/GroupDescriptionOverview-V4.astro";
---

<Layout content={{ title: "Gruppen - Weinerlebnistouren-Pfalz" }}>
  <Header isHome={false} isGroupe={true} />
  <main class="relative min-h-screen bg-gradient-to-b from-white to-gray-50">
    <!-- <ScreenSizeDEVTOOL /> -->
    <!-- Hero Section -->
    <div
      class="relative w-full h-[30vw] min-h-[250px] max-h-[300px]"
      style={{
        backgroundImage: `url("${CompressedMjVineYardColorPencilSketch.src}")`,
        backgroundSize: "cover",
        backgroundPosition: "100% 50%",
      }}
    >
      <div
        class="flex justify-center items-center w-full h-full bg-gradient-to-t to-transparent from-black/80 via-black/60"
      >
        <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
          <div class="flex flex-col justify-center items-center text-center">
            <h1
              class="mb-6 text-4xl font-bold text-gray-100 sm:text-5xl md:text-6xl"
            >
              Gruppen-Erlebnisse
            </h1>
            <p
              class="mx-auto max-w-4xl text-sm leading-relaxed sm:text-base md:text-xl lg:text-2xl sm:max-w-md md:max-w-xl text-accent1"
            >
              Entdecken Sie die Pfalz gemeinsam - maßgeschneiderte
              Wein-Erlebnistouren für Gruppen jeder Größe
            </p>
          </div>
        </div>
      </div>
    </div>
    <!-- Group Types Overview -->
    <div
      class="mx-auto w-screen"
      style={{
        backgroundImage: `url("${GimmeldingenMap.src}")`,
        backgroundSize: "cover",
        backgroundPosition: "bottom center",
        backgroundRepeat: "no-repeat",
      }}
    >
      <div
        class="px-4 pt-16 w-screen bg-gradient-to-r via-gray-200 sm:px-6 md:px-14 from-gray-200/45 to-gray-200/45"
      >
        <!-- Desktop -->
        <!-- <GroupDescriptionOverview className="hidden lg:flex w-full flex-row mb-16 gap-x-4 max-w-[400px] lg:max-w-[1000px] mx-auto" />
				 <GroupDescriptionOverviewV2 className="hidden lg:flex w-full flex-row mb-16 gap-x-4 max-w-[400px] lg:max-w-[1000px] mx-auto" />
				 <GroupDescriptionOverviewV3 className="hidden lg:flex w-full flex-row mb-16 gap-x-4 max-w-[400px] lg:max-w-[1000px] mx-auto" /> -->
        <GroupDescriptionOverviewV4
          className="hidden lg:flex w-full flex-row mb-16 gap-x-4 max-w-[400px] lg:max-w-[1000px] mx-auto"
        />

        <!-- Mobile -->
        <div
          class="hidden sm:grid lg:hidden grid-cols-3 gap-3 mb-16 w-full max-w-[400px] sm:max-w-[700px] mx-auto"
        >
          <!-- Small Groups -->
          <div
            class="relative px-9 py-2 pt-6 text-center bg-white rounded-xl shadow-lg transition-shadow hover:shadow-xl borter-2 border-text/20"
          >
            <h3
              class="mt-1 mb-4 text-xl font-bold leading-none border-b-2 font-bonanova text-text border-accent2-wine"
            >
              Kleingruppen
            </h3>
            <div
              class="flex justify-center items-center mx-auto w-12 h-12 rounded-full bg-stone-300/20 -5xl 8"
            >
              <svg
                class="w-7 h-7 text-accent2-wine"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"
                ></path>
              </svg>
            </div>
            <p class="text-5xl text-accent1/60">10-28</p>
            <p
              class="-mt-2 mb-2 text-base tracking-widest uppercase text-accent1"
            >
              Personen
            </p>
            <div class="flex justify-center w-full">
              <div
                class="flex justify-center items-center mt-2 w-16 h-16 text-white bg-opacity-80 rounded-full bg-accent2-wine"
              >
                <span class="text-lg font-bold">4h</span>
              </div>
            </div>
            <!-- <p class="-mt-2 text-3xl text-text/20">---</p> -->
          </div>

          <!-- Corporate Events -->
          <a
            class="relative px-9 py-4 pt-6 text-center bg-white rounded-xl shadow-lg transition-shadow hover:shadow-xl borter-2 border-text/20"
            href="/firmen-events"
          >
            <h3
              class="mt-1 mb-4 text-xl font-bold leading-none border-b-2 font-bonanova text-text border-accent2-wine"
            >
              FirmenEvents
            </h3>
            <div
              class="flex justify-center items-center mx-auto w-12 h-12 rounded-full bg-stone-300/20 -5xl 8"
            >
              <svg
                class="w-7 h-7 text-accent2-wine"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                ></path>
              </svg>
            </div>
            <p class="text-5xl text-accent1/60">10-28</p>
            <p
              class="-mt-2 mb-2 text-base tracking-widest uppercase text-accent1"
            >
              Personen
            </p>
            <div class="flex justify-center w-full">
              <div
                class="flex justify-center items-center mt-2 w-16 h-16 text-white bg-opacity-80 rounded-full bg-accent2-wine"
              >
                <span class="text-base font-bold">4-8h</span>
              </div>
            </div>
            <!-- <p class="-mt-2 text-3xl text-text/20">---</p> -->
          </a>

          <!-- Travel Groups -->
          <div
            class="relative px-9 py-4 pt-6 text-center bg-white rounded-xl shadow-lg transition-shadow hover:shadow-xl borter-2 border-text/20"
          >
            <h3
              class="mt-1 mb-4 text-xl font-bold leading-none border-b-2 font-bonanova text-text border-accent2-wine"
            >
              Reisegruppen
            </h3>
            <div
              class="flex justify-center items-center mx-auto w-12 h-12 rounded-full bg-stone-300/20 -5xl 8"
            >
              <svg
                class="w-7 h-7 text-accent2-wine"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
              </svg>
            </div>
            <p class="text-5xl text-accent1/60">30-50</p>
            <p
              class="-mt-2 mb-2 text-base tracking-widest uppercase text-accent1"
            >
              Personen
            </p>
            <div class="flex justify-center w-full">
              <div
                class="flex justify-center items-center mt-2 w-16 h-16 text-white bg-opacity-80 rounded-full bg-accent2-wine"
              >
                <span class="text-base font-bold">1-2h</span>
              </div>
            </div>
            <!-- <p class="-mt-2 text-3xl text-text/20">---</p> -->
          </div>
        </div>

        <!-- Detailed Sections -->
        <div
          class="space-y-20 max-w-[400px] sm:max-w-[700px] lg:max-w-[1000px] mx-auto"
        >
          <!-- Small Groups Section -->
          <section id="kleingruppen" class="overflow-hidden relative bg-white rounded-2xl border-2 shadow-lg border-orange-200/50"
          >
            <div class="grid grid-cols-1 lg:grid-cols-2">
              <!-- Image Area left LG and bigger -->
              <div 
                class="hidden overflow-hidden relative justify-center items-center lg:flex"
              >
                <Image
                  src={OnSitePhotosGruppenfotoBeiSteigelmanns}
                  loading="eager"
                  alt="Kleingruppen"
                  class="w-full h-full object-cover absolute top-0 left-0 z-0 scale-[2.2]"
                />
                <div
                  class="flex z-10 justify-center items-center w-full h-full bg-gradient-to-br from-white lg:bg-gradient-to-tl via-white/80 to-white/5"
                >
                  <div
                    class="flex flex-col justify-center items-center w-full h-full text-center bg-gradient-to-tl from-white via-white/40 to-white/0"
                  >
                    <div
                      class="hidden relative flex-col justify-center items-center p-8 mx-auto mb-2 rounded-full lg:flex aspect-square bg-white/80"
                    >
                      <svg
                        class="absolute z-0 p-12 m-auto w-full h-full text-text/5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"
                        ></path>
                      </svg>
                      <p
                        class="hidden z-10 mx-4 mt-4 text-6xl tracking-tighter lg:block text-accent1"
                      >
                        10-28
                      </p>
                      <p
                        class="hidden z-10 -mt-4 text-lg tracking-widest uppercase lg:block text-accent1"
                      >
                        Personen
                      </p>
                    </div>
                  </div>
                </div>
              </div>
              <!-- Image Area left MD and smaller -->
              <div class="block inset-0 z-10 lg:hidden">
                <Image
                  src={OnSitePhotosGruppenfotoBeiSteigelmanns}
                  loading="lazy"
                  fetchpriority="auto"
                  alt="Kleingruppen"
                  class="w-2/3 aspect-square object-cover absolute bottom-0 left-2/3 sm:-bottom-44 sm:-right-20 z-0 scale-[1.7]"
                />
                <div
                  class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-white via-white/50 to-white/0"
                >
                </div>
                <div
                  class="w-full h-[60%] sm:h-full absolute bottom-0 sm:top-0 right-0 bg-gradient-to-b from-white via-white to-transparent"
                >
                </div>
                <div
                  class="w-1/5 sm:w-1/2 lg:w-full h-full absolute top-0 left-1/2 md:-translate-x-[50px] -translate-x-[48px] sm:right-12 bg-gradient-to-r from-white via-white/90 to-transparent"
                >
                </div>
                <div
                  class="absolute top-0 left-1/4 w-1/3 h-full bg-gradient-to-r from-white to-transparent md:hidden sm:w-1/2 lg:w-full sm:right-12 via-white/90"
                >
                </div>
              </div>
              <!-- Content Area left MD and smaller -->
              <div class="relative z-10 p-8 lg:p-12">
                <div
                  class="flex flex-row justify-center items-center mx-auto mb-3"
                >
                  <div
                    class="flex justify-center items-center mx-auto mb-3 w-24 rounded-full lg:hidden aspect-square bg-stone-50/80"
                  >
                    <svg
                      class="w-12 h-12 text-accent2-wine"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"
                      ></path>
                    </svg>
                  </div>
                  <h2 class="mb-6 w-4/5 text-3xl font-bold text-text">
                    Kleingruppen-Erlebnisse
                  </h2>
                </div>
                <p
                  class="px-8 mb-8 text-sm leading-relaxed sm:text-base text-text/60"
                >
                  Verschiedene 4-stündige Wein-Erlebnistouren für private
                  Gruppen. Erleben Sie die Pfalz an Ihrem Wunschtermin in
                  entspannter, persönlicher Atmosphäre. Ob mit Familie, Freunden
                  oder Kollegen aus Verein oder Beruf, die interaktiven Touren
                  stärken Ihren Gruppenzusammenhalt.
                </p>
                <div class="mb-8 space-y-4">
                  <div class="flex items-start space-x-3">
                    <svg
                      class="flex-shrink-0 mt-1 w-6 h-6 text-accent1"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <div>
                      <h4 class="font-semibold text-gray-900">
                        Kleine private Touren
                      </h4>
                      <p class="text-gray-600">
                        Ihre Gruppe wächst zum echten Team
                      </p>
                    </div>
                  </div>
                  <div class="flex items-start space-x-3">
                    <svg
                      class="flex-shrink-0 mt-1 w-6 h-6 text-accent1"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <div>
                      <h4 class="font-semibold text-gray-900">
                        Persönliche Betreuung
                      </h4>
                      <p class="text-gray-600">
                        Individuell abgestimmt, offen für alle Fragen
                      </p>
                    </div>
                  </div>
                  <div class="flex items-start space-x-3">
                    <svg
                      class="flex-shrink-0 mt-1 w-6 h-6 text-accent1"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <div>
                      <h4 class="font-semibold text-gray-900">
                        Flexible Termine
                      </h4>
                      <p class="text-gray-600">
                        Einfach den passenden Wunschtermin wählen
                      </p>
                    </div>
                  </div>
                </div>
                <div class="block lg:hidden">
                  <p
                    class="mt-12 text-base font-bold tracking-widest uppercase text-text/40"
                  >
                    Geeignet Für
                  </p>
                  <p class="-mt-1 text-6xl text-accent1/80">10-28</p>
                  <p
                    class="-mt-4 text-3xl tracking-wide uppercase text-accent1 font-playfair"
                  >
                    Personen
                  </p>
                </div>
                <a
                  href="/kontakt"
                  class="inline-flex items-center px-6 py-3 mb-4 font-semibold text-white bg-gradient-to-r rounded-lg transition-colors bg-accent2-plum from-accent2-wine to-accent2-wine/80 hover:bg-orange-700"
                >
                  Jetzt anmelden
                  <svg
                    class="ml-2 w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          </section>

          <!-- Corporate Events Section -->
          <section id="firmenevents" class="overflow-hidden relative w-full h-full bg-white rounded-2xl border-2 shadow-lg border-orange-200/50"
          >
            <div class="inset-0">
              <Image
                src={GeminiBusinessTrip}
                loading="lazy"
                fetchpriority="auto"
                alt="Kleingruppen"
                class="w-1/2 aspect-square object-cover absolute bottom-0 right-0 z-0 scale-[1.5] sm:scale-[1]"
              />
              <div
                class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-white via-white/50 to-white/0"
              >
              </div>
              <div
                class="w-full h-full absolute top-[20%] sm:top-0 left-0 bg-gradient-to-b from-white via-white to-transparent"
              >
              </div>
              <div
                class="absolute top-0 -left-7 w-full h-full bg-gradient-to-r from-white via-white to-transparent sm:left-0"
              >
              </div>
            </div>
            <div class="grid relative z-10 grid-cols-1 lg:grid-cols-2">
              <div class="p-8 lg:p-12">
                <div
                  class="flex flex-row justify-center items-center mx-auto mb-3"
                >
                  <div
                    class="flex justify-center items-center mx-auto mb-3 w-24 rounded-full lg:hidden aspect-square bg-stone-50/80"
                  >
                    <svg
                      class="w-12 h-12 text-accent2-wine"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                      ></path>
                    </svg>
                  </div>
                  <h2 class="mb-6 w-4/5 text-3xl font-bold text-text">
                    Firmen-Events & Team-Building
                  </h2>
                </div>
                <p
                  class="px-8 mb-8 text-sm leading-snug sm:text-base text-text/60"
                >
                  Ein exklusives Event auf Basis meiner Wein-Erlebnistouren –
                  speziell für Ihr Unternehmen. Dauer: 4–8 Stunden, auf Wunsch
                  inklusive Organisation eines gemeinsamen Essens. Perfekt für
                  genussvolles Teambuilding und unvergessliche Firmenausflüge.
                </p>
                <div class="mb-8 space-y-4">
                  <div class="flex items-start space-x-3">
                    <svg
                      class="flex-shrink-0 mt-1 w-6 h-6 text-accent1"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <div>
                      <h4 class="font-semibold text-gray-900">
                        Maßgeschneiderte Konzepte
                      </h4>
                      <p class="text-gray-600">
                        Individuelle Planung nach Ihren Wünschen
                      </p>
                    </div>
                  </div>
                  <div class="flex items-start space-x-3">
                    <svg
                      class="flex-shrink-0 mt-1 w-6 h-6 text-accent1"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <div>
                      <h4 class="font-semibold text-gray-900">
                        Teambuilding-Aktivitäten
                      </h4>
                      <p class="text-gray-600">
                        Ideale Kombination aus Wein-Erlebnistour und
                        Team-Challenges
                      </p>
                    </div>
                  </div>
                  <div class="flex items-start space-x-3">
                    <svg
                      class="flex-shrink-0 mt-1 w-6 h-6 text-accent1"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <div>
                      <h4 class="font-semibold text-gray-900">
                        Professionelle Betreuung
                      </h4>
                      <p class="text-gray-600">
                        Erfahrene Begleitung für ein rundum gelungenes Event
                      </p>
                    </div>
                  </div>
                </div>
                <div class="block w-full lg:hidden">
                  <p
                    class="mt-12 text-base font-bold tracking-widest uppercase text-text/40"
                  >
                    Geeignet Für
                  </p>
                  <p class="-mt-1 text-6xl text-accent1/80">10-28</p>
                  <p
                    class="-mt-4 text-3xl tracking-wide uppercase text-accent1 font-playfair"
                  >
                    Personen
                  </p>
                </div>
                <a
                  href="/kontakt"
                  class="inline-flex items-center px-6 py-3 mb-4 font-semibold text-white bg-gradient-to-r rounded-lg transition-colors bg-accent2-plum from-accent2-wine to-accent2-wine/80 hover:bg-orange-700"
                >
                  Event planen
                  <svg
                    class="ml-2 w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
              <div class="hidden justify-center items-center lg:flex">
                <div
                  class="flex overflow-hidden relative justify-center items-center w-full h-full"
                >
                  <Image
                    src={GeminiBusinessTrip}
                    loading="lazy"
                    fetchpriority="auto"
                    alt="Kleingruppen"
                    class="w-full h-full object-cover object-[-50px_-50px] absolute top-0 left-0 z-0 scale-[1.2]"
                  />
                  <div
                    class="flex z-10 justify-center items-center w-full h-full bg-gradient-to-tr from-white via-white/60 to-white/0"
                  >
                    <div

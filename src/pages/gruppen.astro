---
import Layout from "@/layouts/main.astro";
import { Image } from "astro:assets";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ScreenSizeDEVTOOL from "@/components/ScreenSizeDEVTOOL.astro";
import GimmeldingenMap from "@images/GimmeldingenMap.jpg"; //src/assets/images/GimmeldingenMap.jpg
import GeminiBusinessTrip from "@images/Gemini-Business-Trip.jpeg";
import CompressedMjVineYardColorPencilSketch from "@images/compressed/webP/compressed-mj-vineYard-ColorPencilSketch.webp";
import OnSitePhotosGruppenfotoBeiSteigelmanns from "@images/onSitePhotos/Gruppenfoto_bei_Steigelmanns.jpeg";
import GeminiTravelBus from "@images/Gemini-Travel-Bus.jpeg";
import BookingCard from "@/components/InfoCards/BookingCard.astro";
import GetInTouch from "@/components/InfoCards/GetInTouchCard.astro";
import HWELogoV2noText from "@images/HWE-LogoV2-noText.svg";
import GroupDescriptionOverview from "@/components/GroupDescriptionOverview.astro";
import GroupDescriptionOverviewV2 from "@/components/GroupDescriptionOverview-V2.astro";
import GroupDescriptionOverviewV3 from "@/components/GroupDescriptionOverview-V3.astro";
import GroupDescriptionOverviewV4 from "@/components/GroupDescriptionOverview-V4.astro";
---

<Layout content={{ title: "Gruppen - Weinerlebnistouren-Pfalz" }}>
  <Header isHome={false} isGroupe={true} />
  <main class="min-h-screen bg-gradient-to-b from-white to-gray-50 relative">
    <!-- <ScreenSizeDEVTOOL /> -->
    <!-- Hero Section -->
    <div
      class="relative w-full h-[30vw] min-h-[250px] max-h-[300px]"
      style={{
        backgroundImage: `url("${CompressedMjVineYardColorPencilSketch.src}")`,
        backgroundSize: "cover",
        backgroundPosition: "100% 50%",
      }}>
      <div
        class="w-full h-full flex items-center justify-center
				bg-gradient-to-t from-black/80 via-black/60 to-transparent">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center flex flex-col items-center justify-center">
            <h1
              class="text-4xl sm:text-5xl md:text-6xl font-bold text-gray-100 mb-6">
              Gruppen-Erlebnisse
            </h1>
            <p
              class="text-sm sm:text-base md:text-xl lg:text-2xl sm:max-w-md md:max-w-xl text-accent1 max-w-4xl mx-auto leading-relaxed">
              Entdecken Sie die Pfalz gemeinsam - maßgeschneiderte
              Wein-Erlebnistouren für Gruppen jeder Größe
            </p>
          </div>
        </div>
      </div>
    </div>
    <!-- Group Types Overview -->
    <div
      class="w-screen mx-auto"
      style={{
        backgroundImage: `url("${GimmeldingenMap.src}")`,
        backgroundSize: "cover",
        backgroundPosition: "bottom center",
        backgroundRepeat: "no-repeat",
      }}>
      <div
        class="w-screen px-4 sm:px-6 md:px-14 pt-16
				 bg-gradient-to-r from-gray-200/45 via-gray-200 to-gray-200/45">
        <!-- Desktop -->
        <!-- <GroupDescriptionOverview className="hidden lg:flex w-full flex-row mb-16 gap-x-4 max-w-[400px] lg:max-w-[1000px] mx-auto" />
				 <GroupDescriptionOverviewV2 className="hidden lg:flex w-full flex-row mb-16 gap-x-4 max-w-[400px] lg:max-w-[1000px] mx-auto" />
				 <GroupDescriptionOverviewV3 className="hidden lg:flex w-full flex-row mb-16 gap-x-4 max-w-[400px] lg:max-w-[1000px] mx-auto" /> -->
        <GroupDescriptionOverviewV4
          className="hidden lg:flex w-full flex-row mb-16 gap-x-4 max-w-[400px] lg:max-w-[1000px] mx-auto"
        />

        <!-- Mobile -->
        <div
          class="hidden sm:grid lg:hidden grid-cols-3 gap-3 mb-16 w-full max-w-[400px] sm:max-w-[700px] mx-auto">
          <!-- Small Groups -->
          <div
            class="bg-white rounded-xl shadow-lg py-2 px-9 text-center hover:shadow-xl transition-shadow relative pt-6 borter-2 border-text/20">
            <h3
              class="text-xl font-bonanova font-bold text-text mb-4 mt-1 leading-none border-b-2 border-accent2-wine">
              Kleingruppen
            </h3>
            <div
              class="w-12 h-12 bg-stone-300/20 rounded-full flex items-center justify-center mx-auto -5xl 8">
              <svg
                class="w-7 h-7 text-accent2-wine"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"
                ></path>
              </svg>
            </div>
            <p class="text-accent1/60 text-5xl">10-28</p>
            <p
              class="text-accent1 -mt-2 mb-2 text-base tracking-widest uppercase">
              Personen
            </p>
            <div class="w-full flex justify-center">
              <div
                class="w-16 h-16 bg-accent2-wine bg-opacity-80 text-white mt-2 rounded-full flex items-center justify-center">
                <span class="text-lg font-bold">4h</span>
              </div>
            </div>
            <!-- <p class="text-text/20 text-3xl -mt-2">---</p> -->
          </div>

          <!-- Corporate Events -->
          <div
            class="bg-white rounded-xl shadow-lg py-4 px-9 text-center hover:shadow-xl transition-shadow relative pt-6 borter-2 border-text/20">
            <h3
              class="text-xl font-bonanova font-bold text-text mb-4 mt-1 leading-none border-b-2 border-accent2-wine">
              FirmenEvents
            </h3>
            <div
              class="w-12 h-12 bg-stone-300/20 rounded-full flex items-center justify-center mx-auto -5xl 8">
              <svg
                class="w-7 h-7 text-accent2-wine"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                ></path>
              </svg>
            </div>
            <p class="text-accent1/60 text-5xl">10-28</p>
            <p
              class="text-accent1 -mt-2 mb-2 text-base tracking-widest uppercase">
              Personen
            </p>
            <div class="w-full flex justify-center">
              <div
                class="w-16 h-16 bg-accent2-wine bg-opacity-80 text-white mt-2 rounded-full flex items-center justify-center">
                <span class="text-base font-bold">4-8h</span>
              </div>
            </div>
            <!-- <p class="text-text/20 text-3xl -mt-2">---</p> -->
          </div>

          <!-- Travel Groups -->
          <div
            class="bg-white rounded-xl shadow-lg py-4 px-9 text-center hover:shadow-xl transition-shadow relative pt-6 borter-2 border-text/20">
            <h3
              class="text-xl font-bonanova font-bold text-text mb-4 mt-1 leading-none border-b-2 border-accent2-wine">
              Reisegruppen
            </h3>
            <div
              class="w-12 h-12 bg-stone-300/20 rounded-full flex items-center justify-center mx-auto -5xl 8">
              <svg
                class="w-7 h-7 text-accent2-wine"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
              </svg>
            </div>
            <p class="text-accent1/60 text-5xl">30-50</p>
            <p
              class="text-accent1 -mt-2 mb-2 text-base tracking-widest uppercase">
              Personen
            </p>
            <div class="w-full flex justify-center">
              <div
                class="w-16 h-16 bg-accent2-wine bg-opacity-80 text-white mt-2 rounded-full flex items-center justify-center">
                <span class="text-base font-bold">1-2h</span>
              </div>
            </div>
            <!-- <p class="text-text/20 text-3xl -mt-2">---</p> -->
          </div>
        </div>

        <!-- Detailed Sections -->
        <div
          class="space-y-20 max-w-[400px] sm:max-w-[700px] lg:max-w-[1000px] mx-auto">
          <!-- Small Groups Section -->
          <section
            class="bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-orange-200/50 relative">
            <div class="grid grid-cols-1 lg:grid-cols-2">
              <!-- Image Area left LG and bigger -->
              <div
                class="hidden lg:flex items-center justify-center relative overflow-hidden">
                <Image
                  src={OnSitePhotosGruppenfotoBeiSteigelmanns}
                  loading="eager"
                  alt="Kleingruppen"
                  class="w-full h-full object-cover absolute top-0 left-0 z-0 scale-[2.2]"
                />
                <div
                  class="flex items-center justify-center h-full w-full z-10 bg-gradient-to-br lg:bg-gradient-to-tl from-white via-white/80 to-white/5">
                  <div
                    class="text-center w-full h-full flex flex-col items-center justify-center bg-gradient-to-tl from-white via-white/40 to-white/0">
                    <div
                      class="hidden lg:flex relative aspect-square p-8 bg-white/80 rounded-full items-center justify-center flex-col mx-auto mb-2">
                      <svg
                        class="w-full h-full absolute m-auto text-text/5 p-12 z-0"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"
                        ></path>
                      </svg>
                      <p
                        class="hidden lg:block text-accent1 text-6xl tracking-tighter mx-4 z-10 mt-4">
                        10-28
                      </p>
                      <p
                        class="hidden lg:block text-accent1 -mt-4 text-lg tracking-widest uppercase z-10">
                        Personen
                      </p>
                    </div>
                  </div>
                </div>
              </div>
              <!-- Image Area left MD and smaller -->
              <div class="inset-0 z-10 block lg:hidden">
                <Image
                  src={OnSitePhotosGruppenfotoBeiSteigelmanns}
                  loading="lazy"
                  fetchpriority="auto"
                  alt="Kleingruppen"
                  class="w-2/3 aspect-square object-cover absolute bottom-0 left-2/3 sm:-bottom-44 sm:-right-20 z-0 scale-[1.7]"
                />
                <div
                  class="w-full h-full absolute top-0 left-0 bg-gradient-to-br from-white via-white/50 to-white/0">
                </div>
                <div
                  class="w-full h-[60%] sm:h-full absolute bottom-0 sm:top-0 right-0 bg-gradient-to-b from-white via-white to-transparent">
                </div>
                <div
                  class="w-1/5 sm:w-1/2 lg:w-full h-full absolute top-0 left-1/2 md:-translate-x-[50px] -translate-x-[48px] sm:right-12 bg-gradient-to-r from-white via-white/90 to-transparent">
                </div>
                <div
                  class="md:hidden w-1/3 sm:w-1/2 lg:w-full h-full absolute top-0 left-1/4 sm:right-12 bg-gradient-to-r from-white via-white/90 to-transparent">
                </div>
              </div>
              <!-- Content Area left MD and smaller -->
              <div class="p-8 lg:p-12 relative z-10">
                <div
                  class="flex flex-row items-center justify-center mx-auto mb-3">
                  <div
                    class="lg:hidden flex w-24 aspect-square bg-stone-50/80 rounded-full items-center justify-center mx-auto mb-3">
                    <svg
                      class="w-12 h-12 text-accent2-wine"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"
                      ></path>
                    </svg>
                  </div>
                  <h2 class="w-4/5 text-3xl font-bold text-text mb-6">
                    Kleingruppen-Erlebnisse
                  </h2>
                </div>
                <p
                  class="text-sm sm:text-base text-text/60 mb-8 px-8 leading-relaxed">
                  Verschiedene 4-stündige Wein-Erlebnistouren für private
                  Gruppen. Erleben Sie die Pfalz an Ihrem Wunschtermin in
                  entspannter, persönlicher Atmosphäre. Ob mit Familie, Freunden
                  oder Kollegen aus Verein oder Beruf, die interaktiven Touren
                  stärken Ihren Gruppenzusammenhalt.
                </p>
                <div class="space-y-4 mb-8">
                  <div class="flex items-start space-x-3">
                    <svg
                      class="w-6 h-6 text-accent1 mt-1 flex-shrink-0"
                      fill="currentColor"
                      viewBox="0 0 20 20">
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <div>
                      <h4 class="font-semibold text-gray-900">
                        Kleine private Touren
                      </h4>
                      <p class="text-gray-600">
                        Ihre Gruppe wächst zum echten Team
                      </p>
                    </div>
                  </div>
                  <div class="flex items-start space-x-3">
                    <svg
                      class="w-6 h-6 text-accent1 mt-1 flex-shrink-0"
                      fill="currentColor"
                      viewBox="0 0 20 20">
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <div>
                      <h4 class="font-semibold text-gray-900">
                        Persönliche Betreuung
                      </h4>
                      <p class="text-gray-600">
                        Individuell abgestimmt, offen für alle Fragen
                      </p>
                    </div>
                  </div>
                  <div class="flex items-start space-x-3">
                    <svg
                      class="w-6 h-6 text-accent1 mt-1 flex-shrink-0"
                      fill="currentColor"
                      viewBox="0 0 20 20">
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <div>
                      <h4 class="font-semibold text-gray-900">
                        Flexible Termine
                      </h4>
                      <p class="text-gray-600">
                        Einfach den passenden Wunschtermin wählen
                      </p>
                    </div>
                  </div>
                </div>
                <div class="block lg:hidden">
                  <p
                    class="text-text/40 font-bold mt-12 text-base tracking-widest uppercase">
                    Geeignet Für
                  </p>
                  <p class="text-accent1/80 text-6xl -mt-1">10-28</p>
                  <p
                    class="text-accent1 -mt-4 text-3xl tracking-wide uppercase font-playfair">
                    Personen
                  </p>
                </div>
                <a
                  href="/kontakt"
                  class="inline-flex items-center px-6 py-3 bg-accent2-plum mb-4 bg-gradient-to-r from-accent2-wine to-accent2-wine/80 text-white font-semibold rounded-lg hover:bg-orange-700 transition-colors">
                  Jetzt anmelden
                  <svg
                    class="w-4 h-4 ml-2"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          </section>

          <!-- Corporate Events Section -->
          <section
            class="w-full h-full bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-orange-200/50 relative">
            <div class="inset-0">
              <Image
                src={GeminiBusinessTrip}
                loading="lazy"
                fetchpriority="auto"
                alt="Kleingruppen"
                class="w-1/2 aspect-square object-cover absolute bottom-0 right-0 z-0 scale-[1.5] sm:scale-[1]"
              />
              <div
                class="w-full h-full absolute top-0 left-0 bg-gradient-to-br from-white via-white/50 to-white/0">
              </div>
              <div
                class="w-full h-full absolute top-[20%] sm:top-0 left-0 bg-gradient-to-b from-white via-white to-transparent">
              </div>
              <div
                class="w-full h-full absolute top-0 -left-7 sm:left-0 bg-gradient-to-r from-white via-white to-transparent">
              </div>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 relative z-10">
              <div class="p-8 lg:p-12">
                <div
                  class="flex flex-row items-center justify-center mx-auto mb-3">
                  <div
                    class="lg:hidden flex w-24 aspect-square bg-stone-50/80 rounded-full items-center justify-center mx-auto mb-3">
                    <svg
                      class="w-12 h-12 text-accent2-wine"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                      ></path>
                    </svg>
                  </div>
                  <h2 class="w-4/5 text-3xl font-bold text-text mb-6">
                    Firmen-Events & Team-Building
                  </h2>
                </div>
                <p
                  class="text-sm sm:text-base text-text/60 mb-8 leading-snug px-8">
                  Ein exklusives Event auf Basis meiner Wein-Erlebnistouren –
                  speziell für Ihr Unternehmen. Dauer: 4–8 Stunden, auf Wunsch
                  inklusive Organisation eines gemeinsamen Essens. Perfekt für
                  genussvolles Teambuilding und unvergessliche Firmenausflüge.
                </p>
                <div class="space-y-4 mb-8">
                  <div class="flex items-start space-x-3">
                    <svg
                      class="w-6 h-6 text-accent1 mt-1 flex-shrink-0"
                      fill="currentColor"
                      viewBox="0 0 20 20">
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <div>
                      <h4 class="font-semibold text-gray-900">
                        Maßgeschneiderte Konzepte
                      </h4>
                      <p class="text-gray-600">
                        Individuelle Planung nach Ihren Wünschen
                      </p>
                    </div>
                  </div>
                  <div class="flex items-start space-x-3">
                    <svg
                      class="w-6 h-6 text-accent1 mt-1 flex-shrink-0"
                      fill="currentColor"
                      viewBox="0 0 20 20">
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <div>
                      <h4 class="font-semibold text-gray-900">
                        Teambuilding-Aktivitäten
                      </h4>
                      <p class="text-gray-600">
                        Ideale Kombination aus Wein-Erlebnistour und
                        Team-Challenges
                      </p>
                    </div>
                  </div>
                  <div class="flex items-start space-x-3">
                    <svg
                      class="w-6 h-6 text-accent1 mt-1 flex-shrink-0"
                      fill="currentColor"
                      viewBox="0 0 20 20">
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <div>
                      <h4 class="font-semibold text-gray-900">
                        Professionelle Betreuung
                      </h4>
                      <p class="text-gray-600">
                        Erfahrene Begleitung für ein rundum gelungenes Event
                      </p>
                    </div>
                  </div>
                </div>
                <div class="block lg:hidden w-full">
                  <p
                    class="text-text/40 font-bold mt-12 text-base tracking-widest uppercase">
                    Geeignet Für
                  </p>
                  <p class="text-accent1/80 text-6xl -mt-1">10-28</p>
                  <p
                    class="text-accent1 -mt-4 text-3xl tracking-wide uppercase font-playfair">
                    Personen
                  </p>
                </div>
                <a
                  href="/kontakt"
                  class="inline-flex items-center px-6 py-3 bg-accent2-plum mb-4 bg-gradient-to-r from-accent2-wine to-accent2-wine/80 text-white font-semibold rounded-lg hover:bg-orange-700 transition-colors">
                  Event planen
                  <svg
                    class="w-4 h-4 ml-2"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
              <div class="items-center justify-center hidden lg:flex">
                <div
                  class="flex items-center justify-center h-full w-full relative overflow-hidden">
                  <Image
                    src={GeminiBusinessTrip}
                    loading="lazy"
                    fetchpriority="auto"
                    alt="Kleingruppen"
                    class="w-full h-full object-cover object-[-50px_-50px] absolute top-0 left-0 z-0 scale-[1.2]"
                  />
                  <div
                    class="flex items-center justify-center h-full w-full
										bg-gradient-to-tr from-white via-white/60 to-white/0 z-10">
                    <div
                      class="text-center w-full h-full flex flex-col items-center justify-center
										bg-gradient-to-tr from-white via-white/75 to-white/0">
                      <!-- <h3 class="text-3xl font-bold text-gray-900 my-6 leading-none">FirmenEvents</h3> -->
                      <div
                        class="hidden lg:flex relative aspect-square p-8 bg-white/80 rounded-full items-center justify-center flex-col mx-auto">
                        <svg
                          class="w-full h-full absolute m-auto text-text/5 p-12 z-0"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24">
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"

---
/**
 * Abschluss-CTA der Startseite: buchen, verschenken oder als Gruppe anfragen.
 * Bewusst die letzte Station vor dem Footer — wer bis hierher gescrollt hat,
 * bekommt alle drei Wege noch einmal gebündelt.
 */

import GimmeldingenMap from "@images/GimmeldingenMap.jpg";
import { Image } from "astro:assets";
---

<section
  aria-labelledby="final-cta-title"
  class="overflow-hidden relative py-16 w-full text-center bg-transparent container-padding sm:py-24"
>
  <!-- zarte Farbnebel, wie auf den Unterseiten -->
  <div
    aria-hidden="true"
    class="absolute inset-0 pointer-events-none"
  >
  <Image src={GimmeldingenMap} alt="Gimmeldingen Map" class="object-cover object-top absolute bottom-0 left-0 z-0 opacity-30" />
  </div>
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-gradient-to-t to-transparent pointer-events-none from-gray-200/80"
  >
  </div>

  <div class="relative mx-auto max-w-3xl">
    <div class="flex justify-center mb-8" aria-hidden="true">
      <div
        class="w-px h-14 bg-gradient-to-b from-transparent to-transparent via-accent1/60"
      >
      </div>
    </div>
    <p class="text-3xl font-doulaise text-accent1 sm:text-4xl">
      Auf bald in Gimmeldingen!
    </p>
    <h2
      id="final-cta-title"
      class="mx-auto mt-4 text-3xl font-bold font-bonanova sm:text-5xl"
    >
      Sichern Sie sich Ihren Platz
    </h2>
    <p class="mx-auto mt-5 max-w-xl leading-relaxed font-body text-text/75 sm:text-lg">
      Alle Termine für jede Jahreszeit finden Sie im Buchungskalender — oder
      Sie verschenken eine Weinerlebnistour an Ihre Liebsten.
    </p>
    <div class="flex flex-wrap gap-4 justify-center items-center mt-8">
      <a
        class="px-8 py-3 text-sm font-bold tracking-wider uppercase rounded-full shadow-md transition-all duration-300 bg-accent2-wine font-bonanova text-stone-50 hover:-translate-y-0.5 hover:bg-accent2-wine/90 hover:shadow-lg"
        href="https://eveeno.com/de/event-cal/34263?style=grid"
        rel="noopener noreferrer"
        target="_blank"
      >
        Zum Buchungskalender
      </a>
      <a
        class="px-8 py-3 text-sm font-bold tracking-wider uppercase rounded-full border-2 transition-all duration-300 border-accent1 font-bonanova text-text hover:-translate-y-0.5 hover:bg-soft-beige/60"
        href="/kontakt"
      >
        Tour verschenken
      </a>
    </div>
    <p class="mt-6 text-sm text-text/60">
      Sie planen mit Team, Verein oder Familie? <a
        class="underline transition decoration-accent1/50 underline-offset-4 hover:text-accent2-wine"
        href="/gruppen">Gruppen & private Touren</a
      > · <a
        class="underline transition decoration-accent1/50 underline-offset-4 hover:text-accent2-wine"
        href="/firmen-events">Firmen-Events</a
      >
    </p>
  </div>
</section>

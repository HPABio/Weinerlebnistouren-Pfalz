---
/**
 * „So fühlt sich eine Tour an" — beispielhafter Ablauf in sechs Stationen.
 *
 * Macht das Erlebnis vorstellbar, ohne die Dramaturgie einer konkreten Tour
 * zu spoilern: bewusst ohne Uhrzeiten (die Startzeiten variieren je Tour)
 * und generisch genug für alle vier Jahreszeiten.
 */
import CmsImage from "@/components/cms/CmsImage.astro";
import CmsText from "@/components/cms/CmsText.astro";
import { getSlotImage, getTimelineSteps } from "@/lib/cms/content";
import { editAttr } from "@/lib/cms/edit";

// Inhalte: CMS › Tour-Ablauf (Stationen), Texte, Fotos auf der Website.
// Titel ohne „ß" — Bona Nova SC hat keine saubere ß-Glyphe.
const [steps, photo1, photo2] = await Promise.all([
  getTimelineSteps(),
  getSlotImage("home.timeline.photo1"),
  getSlotImage("home.timeline.photo2"),
]);
---

<section
  id="tour-ablauf"
  aria-labelledby="timeline-title"
  class="overflow-hidden relative py-16 bg-soft-sand/40 scroll-mt-24 sm:py-24"
>
  <!-- stilles Wasserzeichen -->
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -top-2 right-8 hidden select-none font-doulaise text-[10rem] leading-none text-text opacity-[0.05] sm:block"
  >
    <CmsText k="home.timeline.watermark" />
  </span>

  <div
    class="container-padding relative mx-auto grid max-w-6xl items-start gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16"
  >
    <!-- Kopf + echte Tour-Momente -->
    <div class="lg:sticky lg:top-28">
      <p class="text-3xl font-doulaise text-accent1 sm:text-4xl">
        <CmsText k="home.timeline.kicker" />
      </p>
      <div aria-hidden="true" class="mt-5 w-16 h-px bg-accent1/50"></div>
      <h2
        id="timeline-title"
        class="mt-5 text-3xl font-bold leading-tight font-bonanova sm:text-4xl"
      >
        <CmsText k="home.timeline.title" />
      </h2>
      <div class="cms-rich mt-4 max-w-prose leading-relaxed font-body text-text/75">
        <CmsText k="home.timeline.intro" />
      </div>

      <!-- Zwei echte Momente: Rolle & Runde -->
      <div class="hidden gap-5 mt-10 sm:flex lg:mt-12">
        <figure class="w-1/2 rotate-[-2deg]">
          <div
            class="overflow-hidden rounded-xl border-4 border-white shadow-lg"
          >
            <CmsImage
              alt={photo1?.alt ?? ""}
              class="aspect-[4/5] h-auto w-full object-cover"
              file={photo1?.file}
              loading="lazy"
              quality={70}
              sizes="(min-width: 1024px) 230px, 45vw"
              width={480}
              edit={{ collection: "image_slots", item: photo1 && "home.timeline.photo1", fields: ["image", "alt"] }}
            />
          </div>
          <figcaption
            class="mt-2 text-base text-center font-caveat text-text/60"
          >
            <CmsText k="home.timeline.caption1" />
          </figcaption>
        </figure>
        <figure class="mt-8 w-1/2 rotate-[2deg]">
          <div
            class="overflow-hidden rounded-xl border-4 border-white shadow-lg"
          >
            <CmsImage
              alt={photo2?.alt ?? ""}
              class="aspect-[4/5] h-auto w-full object-cover"
              file={photo2?.file}
              loading="lazy"
              quality={70}
              sizes="(min-width: 1024px) 230px, 45vw"
              width={480}
              edit={{ collection: "image_slots", item: photo2 && "home.timeline.photo2", fields: ["image", "alt"] }}
            />
          </div>
          <figcaption
            class="mt-2 text-base text-center font-caveat text-text/60"
          >
            <CmsText k="home.timeline.caption2" />
          </figcaption>
        </figure>
      </div>
    </div>

    <!-- Die sechs Stationen -->
    <ol class="relative">
      {
        steps.map((step, index) => (
          <li class="flex relative gap-5 pb-9 last:pb-0 sm:gap-7">
            {/* Verbindungslinie — beim letzten Schritt ausgeblendet */}
            {index < steps.length - 1 && (
              <span
                aria-hidden="true"
                class="absolute left-[1.15rem] top-11 bottom-0 w-px bg-gradient-to-b from-accent1/50 to-accent1/15 sm:left-[1.35rem]"
              />
            )}
            <span
              aria-hidden="true"
              class="flex justify-center items-center w-9 h-9 text-sm font-bold bg-white rounded-full border shadow-sm shrink-0 border-accent1/40 font-bonanova text-accent1 sm:h-11 sm:w-11 sm:text-base"
            >
              {index + 1}
            </span>
            <div class="pt-1 sm:pt-2" {...editAttr("timeline_steps", step.id, ["title", "text"], "modal")}>
              <h3 class="text-lg font-bold leading-snug font-bonanova sm:text-xl">
                {step.title}
              </h3>
              <div
                class="cms-rich mt-1.5 max-w-prose text-sm leading-relaxed font-body text-text/70 sm:text-base"
                set:html={step.text}
              />
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

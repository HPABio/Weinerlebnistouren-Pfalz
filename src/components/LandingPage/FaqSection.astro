---
/**
 * FAQ — räumt die typischen Kaufbarrieren VOR der Buchung aus dem Weg
 * (Wetter, Schuhwerk, alkoholfrei, Kinder, Anreise, Storno …).
 *
 * Rein statisch über native <details>-Elemente — funktioniert ohne JS.
 * Inhalte: src/data/landingPage.ts. Liefert zusätzlich FAQPage-Markup
 * (JSON-LD) für Suchmaschinen.
 */
import { faqs } from "@/data/landingPage";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};

// Zwei ausgewogene Spalten für Desktop (Reihenfolge bleibt spaltenweise lesbar).
const midpoint = Math.ceil(faqs.length / 2);
const columns = [faqs.slice(0, midpoint), faqs.slice(midpoint)];
---

<section
  id="faq"
  aria-labelledby="faq-title"
  class="relative w-full bg-white py-16 scroll-mt-24 sm:py-24"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  />
  <div class="container-padding relative mx-auto max-w-6xl">

  <p class="text-center font-doulaise text-3xl text-accent1 sm:text-4xl">
    Gut zu wissen
  </p>
  <h2
    id="faq-title"
    class="mx-auto mt-3 max-w-2xl text-center font-bonanova text-3xl font-bold sm:text-4xl"
  >
    Alles Wichtige vor Ihrer Tour
  </h2>
  <p
    class="mx-auto mt-4 max-w-xl text-center font-body leading-relaxed text-text/70"
  >
    Die häufigsten Fragen auf einen Blick — alles Weitere beantworte ich gerne <a
      class="underline decoration-accent1/50 underline-offset-4 transition hover:text-accent2-wine"
      href="/kontakt">persönlich</a
    >.
  </p>

  <div class="mt-10 grid items-start gap-x-8 gap-y-3 lg:grid-cols-2">
    {
      columns.map((column) => (
        <div class="space-y-3">
          {column.map((faq) => (
            <details class="group rounded-2xl border border-accent1/25 bg-white/70 px-5 py-4 shadow-sm transition-shadow duration-300 open:shadow-md sm:px-6">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bonanova text-base font-bold text-text/85 [&::-webkit-details-marker]:hidden sm:text-lg">
                {faq.question}
                <span
                  aria-hidden="true"
                  class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-accent1/40 text-accent1 transition-transform duration-300 group-open:rotate-45"
                >
                  <svg
                    class="h-3 w-3"
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-width="2.4"
                    viewBox="0 0 24 24"
                  >
                    <path d="M12 5v14" />
                    <path d="M5 12h14" />
                  </svg>
                </span>
              </summary>
              <p class="mt-3 max-w-prose font-body text-sm leading-relaxed text-text/70 sm:text-base">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      ))
    }
  </div>
  </div>
</section>

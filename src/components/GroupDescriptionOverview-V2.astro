---
// import { Image } from 'astro:assets';
const { className } = Astro.props;
import HWELogoV2noText from "@images/HWE-LogoV2-noText.svg";
---

<section id="" class={`${className}`}>

  <!-- Kleingruppen -->
  <div class="w-2/3 h-full relative flex flex-row  bg-white rounded-xl shadow-lg text-center hover:shadow-xl transition-shadow border-2 border-text/20 overflow-hidden">
    <img src={HWELogoV2noText.src} alt="Kleingruppen" class="w-full h-full object-cover object-center absolute bottom-0 left-0 z-0 opacity-5 scale-[1.2]" />
    <div class="w-full ">
      <div class="relative w-full h-full flex flex-col items-center justify-center px-8 py-4 z-10 bg-gradient-to-t from-white/50 via-white to-stone-50/20">
        <h3 class="text-3xl font-bold text-gray-900 mt-6 leading-none border-b-4 border-accent2-wine">Kleingruppen</h3>	
        <div class="w-12 aspect-square bg-stone-300/20 rounded-full flex items-center justify-center mx-auto mt-8">
          <svg class="w-7 h-7 text-accent2-wine " fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
          </svg>
        </div>
        <p class="text-accent1/60 text-5xl">10-28</p>
        <p class="text-accent1 -mt-2 text-base tracking-widest uppercase">Personen</p>
        <div class="flex w-full h-full flex-col items-center py-5 px-4 my-4 mt-6 justify-between bg-stone-300/20 rounded-md ">
          <p class="text-xs text-gray-500 font-normal">
            <span class="text-sm xl:text-lg leading-tight font-bold text-accent2-plum">
              Weinerlebnistouren
            </span>
          <p/> 
          <p class="text-xs xl:text-sm leading-tight  xl:leading-tight mt-2 text-text/60">
            Ob mit der Familie, Freunden oder Kollegen - diese Tour passt zu jedem.
          </p>
          <div class=" w-full  ">	
            <p class="w-fit bg-accent2-wine text-white mt-3 text-[0.55rem] font-semibold rounded-full mx-auto px-8">Private Tour</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Corporate Events -->
    <div class="w-full relative text-center overflow-hidden">
      <!-- <img src={HWELogoV2noText.src} alt="Kleingruppen" class="w-full h-full object-cover object-top absolute bottom-0 left-0 z-0 opacity-5 scale-[1.9] rotate-180" /> -->
      <div class="relative w-full h-full flex flex-col items-center justify-center px-8 py-4 z-10 bg-gradient-to-t from-white/50 via-white to-stone-50/20">		
    
      <h3 class="text-3xl font-bold text-gray-900 mt-6 leading-none border-b-4 border-accent2-wine">FirmenEvents</h3>
      
    <div class="w-12 aspect-square bg-stone-300/20 rounded-full flex items-center justify-center mx-auto mt-8">
      <svg class="w-7 h-7 text-accent2-wine " fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
      </svg>
    </div>
      <p class="text-accent1/60 text-5xl">10-28</p>
      <p class="text-accent1 -mt-2 text-base tracking-widest uppercase">Personen</p>
    <div class="flex w-full h-full flex-col items-center justify-between py-5 px-4 my-4 mt-6 bg-stone-300/20 rounded-lg ">
      <p class="text-xs text-gray-500 font-normal">
        <span class="text-sm xl:text-lg lg:leading-none xl:leading-none font-bold text-accent2-plum">
          Weinerlebnistouren & Weinführung
        </span>
      <p/> 	
      <p class="text-xs xl:text-sm leading-tight xl:leading-tight mt-2 text-text/60">
        Passend zu jedem Anlass und individuell auf Sie und Ihre Bedürfnisse zugeschnitten. 
      <div class=" w-full  ">	
        <p class="w-fit bg-accent2-wine text-white mt-5 text-[0.55rem] font-semibold rounded-full mx-auto px-8">Private Tour</p>
      </div>
    </div>
      </div>
    </div>
  </div>
  
  


  <!-- Travel Groups -->
   <div class="w-1/3  relative">
    <div class="w-full h-full relative bg-white rounded-xl shadow-lg text-center hover:shadow-xl transition-shadow border-2 border-text/20 overflow-hidden">
      <img src={HWELogoV2noText.src} alt="Kleingruppen" class="w-full h-full object-cover object-center absolute bottom-0 left-0 z-0 opacity-5 scale-[1.2]" />
      <div class="relative w-full h-full flex flex-col items-center justify-center px-8 py-4 z-10 bg-gradient-to-t from-white/50 via-white to-stone-50/20">		
    <h3 class="text-3xl font-bold text-gray-900 mt-6 leading-none border-b-4 border-accent2-wine">Reisegruppen</h3>
        
      <div class="w-12 aspect-square bg-stone-300/20 rounded-full flex items-center justify-center mx-auto mt-8">
        <svg class="w-7 h-7 text-accent2-wine " fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
        </svg>
      </div>
        <p class="text-accent1/60 text-5xl">30-50</p>
        <p class="text-accent1 -mt-2 text-base tracking-widest uppercase">Personen</p>
      <div class="flex w-full h-full flex-col items-center py-5 px-4 my-4 mt-6 justify-between bg-stone-300/20 rounded-lg ">
        <p class="text-xs text-gray-500 font-normal">
          <span class="text-sm xl:text-lg leading-tight font-bold text-accent2-plum">
            Weinführung
          </span>
        <p/> 
        <p class="text-xs xl:text-sm leading-tight  xl:leading-tight mt-2 text-text/60">
          Für größere Reisegruppen und/oder Reisebusse. Erleben Sie Gimmeldingen zu Fuß und im Glas.
        </p>
        <div class=" w-full  ">	
          <p class="w-fit bg-accent2-wine text-white mt-3 text-[0.55rem] font-semibold rounded-full mx-auto px-8">Private Tour</p>
        </div>
      </div>
    </div>

    </div>
  </div>
  
    
</section>

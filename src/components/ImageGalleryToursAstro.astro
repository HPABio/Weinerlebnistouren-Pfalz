---
// src/components/ImageGalleryToursAstro.astro
import { Image } from "astro:assets";

interface Props {
  numberOfImages?: number;
  className?: string;
}

const { numberOfImages = 12, className = "" } = Astro.props;

// Import all images from the onSitePhotos folder
const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/compressed/onSitePhotos/**/*.{png,jpg,jpeg,webp}",
  { eager: true }
);

// Get all image paths
const imagePaths = Object.keys(images);

// Shuffle array function
function shuffleArray<T>(array: T[]): T[] {
  const shuffled = [...array];
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }
  return shuffled;
}

// Randomly select images
const shuffledPaths = shuffleArray(imagePaths);
const selectedPaths = shuffledPaths.slice(0, numberOfImages);

// Load the selected images
const selectedImages = selectedPaths.map((path) => {
  return images[path].default;
});
---

<div class={`w-full px-4 py-8 ${className}`}>
  <div
    class="grid grid-cols-3 grid-rows-4 gap-4 sm:gap-5 md:gap-6 xl:gap-7 mx-auto max-w-[1400px]">
    {
      selectedImages.map((imageSrc, index) => (
        <div
          class="group relative overflow-hidden rounded-lg transition-all duration-300 ease-in-out opacity-0 animate-fadeInUp hover:-translate-y-1 hover:shadow-[0_10px_25px_rgba(0,0,0,0.15)]"
          data-index={index}>
          <Image
            src={imageSrc}
            alt={`Tour photo ${index + 1}`}
            class="w-full h-full aspect-[3/4] object-cover object-center block rounded-lg transition-transform duration-300 ease-in-out group-hover:scale-105"
            loading={index < 4 ? "eager" : "lazy"}
            quality={65}
            format="webp"
          />
        </div>
      ))
    }
  </div>
</div>

<style>
  /* Custom fade-in animation */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeInUp {
    animation: fadeInUp 0.5s ease forwards;
  }

  /* Staggered animation delays */
  [data-index="0"] {
    animation-delay: 0s;
  }
  [data-index="1"] {
    animation-delay: 0.05s;
  }
  [data-index="2"] {
    animation-delay: 0.1s;
  }
  [data-index="3"] {
    animation-delay: 0.15s;
  }
  [data-index="4"] {
    animation-delay: 0.2s;
  }
  [data-index="5"] {
    animation-delay: 0.25s;
  }
  [data-index="6"] {
    animation-delay: 0.3s;
  }
  [data-index="7"] {
    animation-delay: 0.35s;
  }
  [data-index="8"] {
    animation-delay: 0.4s;
  }
  [data-index="9"] {
    animation-delay: 0.45s;
  }
  [data-index="10"] {
    animation-delay: 0.5s;
  }
  [data-index="11"] {
    animation-delay: 0.55s;
  }
</style>

---
// src/components/ImageGalleryToursAstro.astro
import { Image } from "astro:assets";

interface Props {
  numberOfImages?: number;
  className?: string;
}

const { numberOfImages = 12, className = "" } = Astro.props;

// Import all images from tour folders organized by tour ID
const tourImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/tours/**/*.{png,jpg,jpeg,webp}",
  { eager: true }
);

// Organize images by tour ID based on folder structure
const imagesByTour: Record<string, ImageMetadata[]> = {
  mandelbluete: [],
  mussbach: [],
  bacchus: [],
  gluehwein: [],
  welcome: [], // Welcome tour - will show all images or a default set
};

// Process all tour images and organize by tour ID
Object.entries(tourImages).forEach(([path, imageModule]) => {
  const image = imageModule.default;
  // Extract tour ID from path: ../assets/images/tours/{tourId}/...
  const pathParts = path.split("/");
  const tourIndex = pathParts.findIndex((part) => part === "tours");
  
  if (tourIndex !== -1 && pathParts[tourIndex + 1]) {
    const tourId = pathParts[tourIndex + 1];
    if (imagesByTour[tourId]) {
      imagesByTour[tourId].push(image);
    }
  }
});

// For welcome tour, combine all tour images
imagesByTour.welcome = [
  ...imagesByTour.mandelbluete,
  ...imagesByTour.mussbach,
  ...imagesByTour.bacchus,
  ...imagesByTour.gluehwein,
];

// Flatten all images for initial render (will be filtered client-side)
// Use a Map to avoid duplicates by image src (welcome contains all images)
const allImagesMap = new Map<string, ImageMetadata>();
Object.values(imagesByTour).forEach((images) => {
  images.forEach((img) => {
    if (!allImagesMap.has(img.src)) {
      allImagesMap.set(img.src, img);
    }
  });
});
const allImages = Array.from(allImagesMap.values());

// Create a mapping of tour IDs to image URLs for client-side access
const tourImagesMap: Record<string, string[]> = {};
Object.entries(imagesByTour).forEach(([tourId, images]) => {
  tourImagesMap[tourId] = images.map((img) => img.src);
});
---

<div class={`w-full px-4 py-8 ${className}`}>
  <div
    class="gallery-container grid grid-cols-3 grid-rows-4 gap-4 sm:gap-5 md:gap-6 xl:gap-7 mx-auto max-w-[1400px]"
    data-num-images={numberOfImages}>
    {
      allImages.map((imageSrc, index) => {
        // Determine which tour this image belongs to
        const tourId = Object.entries(imagesByTour).find(([_, images]) =>
          images.includes(imageSrc)
        )?.[0] || "welcome";
        
        return (
          <div
            class="gallery-item group relative overflow-hidden rounded-lg transition-all duration-300 ease-in-out hover:-translate-y-1 hover:shadow-[0_10px_25px_rgba(0,0,0,0.15)]"
            data-index={index}
            data-tour-id={tourId}
            data-image-src={imageSrc.src}
            style={`animation-delay: ${index * 0.05}s`}>
            <Image
              src={imageSrc}
              alt={`Tour photo ${index + 1}`}
              class="gallery-image w-full h-full aspect-[3/4] object-cover object-center block rounded-lg transition-transform duration-300 ease-in-out group-hover:scale-105"
              loading={index < 6 ? "eager" : "lazy"}
              decoding="async"
              quality={70}
              format="webp"
            />
          </div>
        );
      })
    }
  </div>
  
  <!-- Store tour images mapping for client-side access -->
  <script define:vars={{ tourImagesMap }}>
    window.tourImagesMap = tourImagesMap;
  </script>

  <!-- Refresh Button -->
  <div class="flex justify-end mt-6">
    <button
      id="refresh-gallery-btn"
      class="refresh-gallery-btn group relative w-12 h-12 bg-gradient-to-br from-stone-50/85 to-stone-100/50 shadow-md border border-stone-200/50 rounded-full transition-all duration-300 hover:shadow-lg hover:from-stone-100/90 hover:to-stone-50/60 hover:-translate-y-0.5 active:translate-y-0 disabled:opacity-40 disabled:cursor-not-allowed"
      aria-label="Neue Bilder laden">
      <svg
        class="refresh-icon w-5 h-5 mx-auto text-stone-600/70 transition-transform duration-500 group-hover:rotate-180 group-hover:text-accent1/80"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
        ></path>
      </svg>
    </button>
  </div>
</div>

<script>
  // Client-side randomization and image loading handler
  function selectAndDisplayImages(currentTourId = null, isRefresh = false) {
    const container = document.querySelector(".gallery-container");
    if (!container) return;

    const galleryItems = container.querySelectorAll(".gallery-item");
    const numberOfImages = parseInt(
      container.getAttribute("data-num-images") || "12"
    );

    // Get current tour ID from store if not provided
    if (!currentTourId && window.tourStore) {
      const currentTour = window.tourStore.getCurrentTour();
      currentTourId = currentTour?.id || "welcome";
    } else if (!currentTourId) {
      currentTourId = "welcome";
    }

    // If refreshing, first fade out current images
    if (isRefresh) {
      galleryItems.forEach((item) => {
        item.classList.remove("loaded");
      });
    }

    // Small delay to allow fade out animation
    setTimeout(
      () => {
        // Filter items by current tour ID
        const tourItems = Array.from(galleryItems).filter((item) => {
          const itemTourId = item.getAttribute("data-tour-id");
          return itemTourId === currentTourId;
        });

        // If no items found for this tour, fall back to welcome (all images)
        const itemsToUse =
          tourItems.length > 0 ? tourItems : Array.from(galleryItems);

        // Shuffle for true randomization
        const shuffled = itemsToUse.sort(() => Math.random() - 0.5);

        // Select only the first numberOfImages items
        const selectedItems = shuffled.slice(0, numberOfImages);
        const unselectedItems = shuffled.slice(numberOfImages);

        // Hide all items first
        galleryItems.forEach((item) => {
          (item as HTMLElement).style.display = "none";
        });

        // Hide unselected items from current tour
        unselectedItems.forEach((item) => {
          (item as HTMLElement).style.display = "none";
        });

        // Show and re-append selected items in random order
        selectedItems.forEach((item, newIndex) => {
          container.appendChild(item);
          (item as HTMLElement).style.display = "block"; // Ensure it's visible
          // Update animation delay for new order
          (item as HTMLElement).style.animationDelay = `${newIndex * 0.05}s`;
          (item as HTMLElement).setAttribute("data-index", newIndex.toString());
        });

        // Handle image loading for selected items only
        selectedItems.forEach((item) => {
          const img = item.querySelector("img");

          if (img) {
            // If image is already loaded (cached), show immediately
            if (img.complete) {
              item.classList.add("loaded");
            } else {
              // Wait for image to load
              img.addEventListener("load", () => {
                item.classList.add("loaded");
              });

              // Fallback in case of error
              img.addEventListener("error", () => {
                item.classList.add("loaded");
              });
            }
          }
        });
      },
      isRefresh ? 300 : 0
    );
  }

  function waitForTourStore(maxAttempts = 50, interval = 100) {
    return new Promise((resolve) => {
      let attempts = 0;
      const checkStore = () => {
        if (window.tourStore || attempts >= maxAttempts) {
          resolve(window.tourStore || null);
        } else {
          attempts++;
          setTimeout(checkStore, interval);
        }
      };
      checkStore();
    });
  }

  async function initGallery() {
    // Wait for tour store to be available (React component loads asynchronously)
    await waitForTourStore();

    // Get initial tour from store
    let currentTourId = "welcome";
    if (window.tourStore) {
      const currentTour = window.tourStore.getCurrentTour();
      currentTourId = currentTour?.id || "welcome";
    }

    selectAndDisplayImages(currentTourId, false);

    // Subscribe to tour store changes
    if (window.tourStore) {
      window.tourStore.subscribe((tour) => {
        selectAndDisplayImages(tour.id, true);
      });
    }

    // Add click handler for refresh button
    const refreshBtn = document.getElementById("refresh-gallery-btn");
    if (refreshBtn) {
      refreshBtn.addEventListener("click", () => {
        // Disable button temporarily
        refreshBtn.setAttribute("disabled", "true");

        // Add spinning animation to icon
        const icon = refreshBtn.querySelector(".refresh-icon");
        if (icon) {
          icon.classList.add("rotating");
        }

        // Get current tour for refresh
        let currentTourId = "welcome";
        if (window.tourStore) {
          const currentTour = window.tourStore.getCurrentTour();
          currentTourId = currentTour?.id || "welcome";
        }

        // Refresh the gallery
        selectAndDisplayImages(currentTourId, true);

        // Re-enable button after animation completes
        setTimeout(() => {
          refreshBtn.removeAttribute("disabled");
          if (icon) {
            icon.classList.remove("rotating");
          }
        }, 1000);
      });
    }
  }

  // Run on initial load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGallery);
  } else {
    initGallery();
  }

  // Re-run after view transitions (if using Astro view transitions)
  document.addEventListener("astro:page-load", initGallery);
</script>

<style>
  /* Custom fade-in animation */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Rotation animation for refresh icon */
  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* Gallery items start invisible */
  .gallery-item {
    opacity: 0;
    display: none; /* Hide all initially, JS will show selected ones */
    transition: opacity 0.3s ease-out;
  }

  /* Only animate when loaded */
  .gallery-item.loaded {
    animation: fadeInUp 0.5s ease forwards;
  }

  /* Apply spinning animation to icon */
  .refresh-icon.rotating {
    animation: spin 1s linear;
  }

  /* Improve lazy loading performance */
  .gallery-image {
    /* Prevent layout shift during loading */
    content-visibility: auto;
  }

  /* Smooth grid transitions */
  .gallery-container {
    contain: layout style paint;
  }
</style>

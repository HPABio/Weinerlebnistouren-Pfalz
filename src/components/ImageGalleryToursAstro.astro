---
// src/components/ImageGalleryToursAstro.astro
import { Image } from 'astro:assets';

interface Props {
  numberOfImages?: number;
  className?: string;
}

const { numberOfImages = 12, className = "" } = Astro.props;

// Import all images from the onSitePhotos folder
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/compressed/onSitePhotos/**/*.{png,jpg,jpeg,webp}',
  { eager: true }
);

// Get all image paths
const imagePaths = Object.keys(images);

// Shuffle array function
function shuffleArray<T>(array: T[]): T[] {
  const shuffled = [...array];
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }
  return shuffled;
}

// Randomly select images
const shuffledPaths = shuffleArray(imagePaths);
const selectedPaths = shuffledPaths.slice(0, numberOfImages);

// Load the selected images
const selectedImages = selectedPaths.map((path) => {
  return images[path].default;
});
---

<div class={`image-gallery-tours ${className}`}>
  <div class="masonry-grid">
    {selectedImages.map((imageSrc, index) => (
      <div 
        class="masonry-item"
        data-index={index}
      >
        <Image
          src={imageSrc}
          alt={`Tour photo ${index + 1}`}
          class="gallery-image"
          loading={index < 4 ? "eager" : "lazy"}
          quality={85}
          format="webp"
        />
      </div>
    ))}
  </div>
</div>

<style>
  .image-gallery-tours {
    width: 100%;
    padding: 2rem 1rem;
  }

  .masonry-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(4, 1fr);
    gap: 1rem;
    margin: 0 auto;
    max-width: 1400px;
  }

  @media (min-width: 640px) {
    .masonry-grid {
      gap: 1.25rem;
    }
  }

  @media (min-width: 768px) {
    .masonry-grid {
      gap: 1.5rem;
    }
  }

  @media (min-width: 1280px) {
    .masonry-grid {
      gap: 1.75rem;
    }
  }

  .masonry-item {
    position: relative;
    overflow: hidden;
    border-radius: 0.5rem;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    opacity: 0;
    animation: fadeInUp 0.5s ease forwards;
  }

  .masonry-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 0.5rem;
    transition: transform 0.3s ease;
  }

  .masonry-item:hover .gallery-image {
    transform: scale(1.05);
  }

  /* Staggered fade-in animation */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .masonry-item[data-index="0"] { animation-delay: 0s; }
  .masonry-item[data-index="1"] { animation-delay: 0.05s; }
  .masonry-item[data-index="2"] { animation-delay: 0.1s; }
  .masonry-item[data-index="3"] { animation-delay: 0.15s; }
  .masonry-item[data-index="4"] { animation-delay: 0.2s; }
  .masonry-item[data-index="5"] { animation-delay: 0.25s; }
  .masonry-item[data-index="6"] { animation-delay: 0.3s; }
  .masonry-item[data-index="7"] { animation-delay: 0.35s; }
  .masonry-item[data-index="8"] { animation-delay: 0.4s; }
  .masonry-item[data-index="9"] { animation-delay: 0.45s; }
  .masonry-item[data-index="10"] { animation-delay: 0.5s; }
  .masonry-item[data-index="11"] { animation-delay: 0.55s; }
</style>


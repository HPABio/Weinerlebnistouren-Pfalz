---
// import { Image } from 'astro:assets';
const { className } = Astro.props;
import HWELogoV2noText from "@images/HWE-LogoV2-noText.svg";
---

<section id="" class={`${className}`}>

  <!-- Small Groups -->
  <a href="/gruppen#kleingruppen"
  class="overflow-hidden relative w-full text-center bg-white rounded-xl border-2 shadow-lg transition-shadow hover:shadow-xl border-text/20">
    <img src={HWELogoV2noText.src} alt="Kleingruppen" class="w-full object-cover object-top absolute bottom-0 left-0 z-0 opacity-5 scale-[1.6]" />
    <div class="flex relative z-10 flex-col justify-center items-center px-8 py-4 w-full bg-gradient-to-t via-white from-white/50 to-stone-50/20">
      <h3 class="mt-6 text-3xl font-bold leading-none text-gray-900 border-b-4 border-accent2-wine">Kleingruppen</h3>	
      <div class="flex justify-center items-center mx-auto mt-8 w-12 rounded-full aspect-square bg-stone-300/20">
        <svg class="w-7 h-7 text-accent2-wine" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
        </svg>
      </div>
      <p class="text-5xl text-accent1/60">10-28</p>
      <p class="-mt-2 text-base tracking-widest uppercase text-accent1">Personen</p>
      <div class="flex flex-col justify-between items-center px-10 py-5 my-4 mt-6 w-full rounded-lg bg-stone-300/20">
        <p class="text-xs font-normal text-gray-500">
          <span class="text-sm font-bold xl:text-lg lg:leading-none xl:leading-none text-accent2-plum">
            Weinerlebnistouren & Weinführung 
          </span><br/><br/>
        </p> 
        <p class="mt-2 text-xs leading-tight xl:text-sm xl:leading-tight text-text/60">
          Ob mit der Familie, Freunden oder Kollegen - diese Tour passt zu jedem.
        </p>
        <div class="flex justify-center w-full">	
          <div class="flex justify-center items-center mt-3 w-16 h-16 text-white bg-opacity-80 rounded-full bg-accent2-wine">
            <span class="text-lg font-bold">4h</span>
          </div>
        </div>
      </div>
    </div>
  </a>


  <!-- Corporate Events -->
  <a class="overflow-hidden relative w-full text-center bg-white rounded-xl border-2 shadow-lg transition-shadow hover:shadow-xl border-text/20"
  href="/firmen-events">
    <img src={HWELogoV2noText.src} alt="Kleingruppen" class="w-full object-cover object-top absolute bottom-0 left-0 z-0 opacity-5 scale-[1.9] rotate-180" />
    <div class="flex relative z-10 flex-col justify-center items-center px-8 py-4 w-full bg-gradient-to-t via-white from-white/50 to-stone-50/20">		
  
    <h3 class="mt-6 text-3xl font-bold leading-none text-gray-900 border-b-4 border-accent2-wine">FirmenEvents</h3>
    
  <div class="flex justify-center items-center mx-auto mt-8 w-12 rounded-full aspect-square bg-stone-300/20">
    <svg class="w-7 h-7 text-accent2-wine" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
    </svg>
  </div>
    <p class="text-5xl text-accent1/60">10-28</p>
    <p class="-mt-2 text-base tracking-widest uppercase text-accent1">Personen</p>
  <div class="flex flex-col justify-between items-center px-6 py-5 my-4 mt-6 w-full rounded-lg bg-stone-300/20">
    <p class="text-xs font-normal text-gray-500">
      <span class="text-sm font-bold xl:text-lg lg:leading-none xl:leading-none text-accent2-plum">
        Individuell angepasste <br/> Touren
      </span>
    </p> 	
    <p class="mt-2 text-xs leading-tight xl:text-sm xl:leading-tight text-text/60">
      Exklusiv, passend zu jedem Anlass und individuell auf Sie und Ihre Bedürfnisse zugeschnitten. 
    </p>
    <div class="flex justify-center w-full">	
      <div class="flex justify-center items-center mt-5 w-16 h-16 text-white bg-opacity-80 rounded-full bg-accent2-wine">
        <span class="text-base font-bold">4-8h</span>
      </div>
    </div>
  </div>
    </div>
  </a>

  <!-- Travel Groups -->
  <a href="/gruppen#reisegruppen"
   class="overflow-hidden relative w-full text-center bg-white rounded-xl border-2 shadow-lg transition-shadow hover:shadow-xl border-text/20">
    <img src={HWELogoV2noText.src} alt="Kleingruppen" class="w-full object-cover object-center absolute bottom-0 left-0 z-0 opacity-5 scale-[1.2]" />
    <div class="flex relative z-10 flex-col justify-center items-center px-8 py-4 w-full bg-gradient-to-t via-white from-white/50 to-stone-50/20">		
  <h3 class="mt-6 text-3xl font-bold leading-none text-gray-900 border-b-4 border-accent2-wine">Reisegruppen</h3>
      
    <div class="flex justify-center items-center mx-auto mt-8 w-12 rounded-full aspect-square bg-stone-300/20">
      <svg class="w-7 h-7 text-accent2-wine" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
      </svg>
    </div>
      <p class="text-5xl text-accent1/60">30-80</p>
      <p class="-mt-2 text-base tracking-widest uppercase text-accent1">Personen</p>
    <div class="flex flex-col justify-between items-center px-6 py-5 my-4 mt-6 w-full rounded-lg bg-stone-300/20">
      <p class="text-xs font-normal text-gray-500">
        <span class="text-sm font-bold xl:text-lg lg:leading-none xl:leading-none text-accent2-plum">
          Weinführung & Mandelblütenführung
        </span>
      </p> 
      <p class="mt-2 text-xs leading-tight xl:text-sm xl:leading-tight text-text/60">
        Für größere Reisegruppen und/oder Reisebusse. Erleben Sie Gimmeldingen zu Fuß und im Glas.
      </p>
      <div class="flex justify-center w-full">	
        <div class="flex justify-center items-center mt-3 w-16 h-16 text-white bg-opacity-80 rounded-full bg-accent2-wine">
          <span class="text-base font-bold">1-2h</span>
        </div>
      </div>
    </div>
  </div>
</a>
    
</section>

---
import { Image } from "astro:assets";
import HWELogoV2NoText from "@images/HWE-LogoV2-noText.svg";

// Define links here for easy management
const links = [
  {
    title: "Webseite",
    url: "/",
    icon: "home", // Using a string to switch icons below
    color: "from-accent1 to-accent1/90"
  },
  {
    title: "Instagram",
    url: "https://www.instagram.com/weinerlebnistoure_pfalz/", // Educated guess or placeholder, checking valid format
    icon: "instagram",
    color: "from-[#E1306C] to-[#C13584]" // Insta brand colors or keep uniform? User said "overall vibe of GetInTouchCard", which implies keeping the accent1 color. 
    // However, "Icons for Instagram..." might imply brand colors. Linktree usually has uniform buttons OR brand colors. 
    // The user said "Use the background, borders, shadows and overall vibe of GetInTouchCard", so I will stick to the accent1 theme for consistency/vibe, 
    // maybe with slight variations or just uniform. "overall vibe" strongly suggests the theme colors. 
    // Let's use the theme colors for buttons to match the "vibe".
  },
  {
    title: "LinkedIn",
    url: "https://www.linkedin.com/in/dr-brigitta-heyl-frank-85603036a/", // Placeholder
    icon: "linkedin",
    color: "from-[#0077B6] to-[#005F9D]", // LinkedIn brand colors
  },
  {
    title: "Facebook",
    url: "https://www.facebook.com/", // Placeholder
    icon: "facebook",
  },
  {
    title: "Presse & Artikel",
    url: "#presse", // Maybe scroll to a section or a modal? Or just a placeholder. 
    // The footer had 3 individual links. A linktree usually lists them. 
    // I will add a separate section or list them individually if there are few.
    // Let's make this a "Link Group" or just one button for "Presse" if there is a page. 
    // Since there isn't a direct page, I will list the Rheinpfalz articles as separate items or a group.
    // Let's listed them as "Artikel: Mandelblüte", etc.
    // Or just "Presseberichte" linking to an anchor on main page if it exists (it doesn't seem to).
    // I will add the specific links found in footer as separate buttons for now.
    icon: "newspaper",
  }
];

const articles = [
  {
    title: "Zwischen Mandel und König Ludwig",
    url: "https://www.rheinpfalz.de/lokal/neustadt_artikel,-zwische-mandel-und-könig-ludwig-erlebnisführung-in-gimmeldingen-_arid,5622874.html"
  },
  {
    title: "Wein-Erlebnistour & Mandelblüte",
    url: "https://www.rheinpfalz.de/pfalzleben/pfalzgefuehl_artikel,-wein-erlebnistour-mandelblüte-meerspinne-monarchen-in-neustadt-gimmeldingen-_arid,5753081.html"
  },
  {
    title: "Weinbergswanderung mit Napoleon",
    url: "https://www.rheinpfalz.de/lokal/neustadt_artikel,-besondere-weinbergswanderung-mit-napoleon-durch-die-reben-_arid,5806456.html"
  }
];
---

<div class="fixed inset-0 w-screen h-screen flex items-center justify-center bg-stone-50 p-2 sm:p-4 z-50 overflow-hidden font-sans touch-none">
  
  <!-- Background Texture/Gradient similar to GetInTouchCard -->
  <div class="absolute inset-0 bg-[url('/noise.png')] opacity-5 pointer-events-none"></div> <!-- Assuming noise texture or just plain -->
  <div class="absolute inset-0 bg-gradient-to-br from-stone-50 via-stone-100 to-stone-200 opacity-60"></div>

  <!-- Main Card -->
  <div class="w-full max-w-md my-auto p-4 sm:p-8 relative overflow-hidden flex flex-col items-center justify-start mb-32
  bg-white/60 backdrop-blur-xl rounded-2xl shadow-xl border border-stone-200/60 ">
    
    <!-- Decorative Background SVG (Matches GetInTouchCard) -->
    <div class="absolute top-0 right-0 w-24 h-24 sm:w-32 sm:h-32 opacity-10 pointer-events-none">
      <svg viewBox="0 0 100 100" class="w-full h-full text-accent1">
        <path d="M50 0 L100 50 L50 100 L0 50 Z" fill="currentColor"/>
      </svg>
    </div>
     <div class="absolute bottom-0 left-0 w-16 h-16 sm:w-24 sm:h-24 opacity-5 pointer-events-none transform rotate-180">
      <svg viewBox="0 0 100 100" class="w-full h-full text-accent1">
        <path d="M50 0 L100 50 L50 100 L0 50 Z" fill="currentColor"/>
      </svg>
    </div>

    <!-- Profile Section -->
    <div class="relative z-10 flex flex-col items-center text-center mb-2 sm:mb-8 shrink-0">
      <div class="w-40 h-40 sm:w-28 sm:h-28 mb-2 sm:mb-4 rounded-full p-1 bg-gradient-to-br from-accent1/20 to-transparent">
           <div class="w-full h-full rounded-full bg-white overflow-visible shadow-inner flex items-center justify-center p-2">
              <!-- Using Logo as Profile Pic for now as requested/inferred -->
              <Image src={HWELogoV2NoText} alt="Brigitta Heyl" class="w-full h-full scale-125 object-contain opacity-90" />
           </div>
      </div>
      
      <h1 class="text-2xl sm:text-3xl font-bold font-bonanova text-gray-800 tracking-tight mb-0.5 sm:mb-1">
        Brigitta Heyl
      </h1>
      <p class="text-sm sm:text-base text-stone-600 font-medium">Weinerlebnistouren Pfalz</p>
    </div>

    <!-- Links Section -->
    <div class="w-full flex flex-col gap-2 sm:gap-4 relative z-10 overflow-y-auto sm:overflow-visible no-scrollbar ">
      
      <!-- Standard Links -->
      <div class="flex flex-row itmes-center justify-center gap-5 my-6">
        {links.filter(l => l.title !== 'Presse & Artikel').map((link) => (
          <a href={link.url} target={link.url.startsWith('http') ? "_blank" : "_self"} rel="noopener noreferrer"
            class="group relative overflow-hidden w-fit flex  items-center p-2 sm:p-4 bg-white/80 hover:bg-white border border-stone-200 rounded-full shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-0.5 shrink-0">
            <div class={`absolute inset-0 w-1 bg-gradient-to-b from-accent1 to-accent1/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300`}></div>
        
            <span class="flex-shrink-0 w-10 h-10 sm:w-10 sm:h-10 flex items-center justify-center rounded-full bg-stone-100 text-accent1 group-hover:bg-accent1/10 transition-colors duration-300">
               {link.icon === 'home' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                  </svg>
               )}
               {link.icon === 'linkedin' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                     <path stroke-linecap="round" stroke-linejoin="round" d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z" />
                     <rect x="2" y="9" width="4" height="12" />
                     <circle cx="4" cy="4" r="2" />
                  </svg>
               )}
               {link.icon === 'instagram' && (
                 <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 11.5a2.5 2.5 0 110 5 2.5 2.5 0 010-5zm-5.5-2.5a8 8 0 1111 0 8 8 0 01-11 0z" /> {/* Simplified Insta circle */}
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="2"></rect>
                    <line x1="17.5" y1="6.5" x2="17.501" y2="6.5" stroke-width="2" stroke-linecap="round"></line>
                 </svg>
               )}
               {link.icon === 'facebook' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                     <path stroke-linecap="round" stroke-linejoin="round" d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
                  </svg>
               )}
            </span>
          </a>
        ))}
      </div>


      <!-- Standard Links -->
      {links.filter(l => l.title !== 'Presse & Artikel').map((link) => (
        <a href={link.url} target={link.url.startsWith('http') ? "_blank" : "_self"} rel="noopener noreferrer" 
          class="hidden group relative overflow-hidden w-full flex items-center p-3 sm:p-4 bg-white/80 hover:bg-white border border-stone-200 rounded-xl shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-0.5 shrink-0">
          <div class={`absolute inset-0 w-1 bg-gradient-to-b from-accent1 to-accent1/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300`}></div>
          
          <span class="flex-shrink-0 w-10 h-10 sm:w-10 sm:h-10 flex items-center justify-center rounded-full bg-stone-100 text-accent1 group-hover:bg-accent1/10 transition-colors duration-300">
             {link.icon === 'home' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
             )}
             {link.icon === 'instagram' && (
               <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 11.5a2.5 2.5 0 110 5 2.5 2.5 0 010-5zm-5.5-2.5a8 8 0 1111 0 8 8 0 01-11 0z" /> {/* Simplified Insta circle */}
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="2"></rect>
                  <line x1="17.5" y1="6.5" x2="17.501" y2="6.5" stroke-width="2" stroke-linecap="round"></line>
               </svg>
             )}
             {link.icon === 'facebook' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                   <path stroke-linecap="round" stroke-linejoin="round" d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
                </svg>
             )}
             {link.icon === 'linkedin' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                   <path stroke-linecap="round" stroke-linejoin="round" d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z" />
                   <rect x="2" y="9" width="4" height="12" />
                   <circle cx="4" cy="4" r="2" />
                </svg>
             )}
          </span>
          
          <span class="flex-grow text-center text-sm sm:text-base text-stone-700 font-semibold group-hover:text-accent1 transition-colors duration-300">
            {link.title}
          </span>
          
          <!-- Arrow Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-5 sm:h-5 text-stone-300 group-hover:text-accent1 transform group-hover:translate-x-1 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      ))}

      <!-- Articles Section -->
      <div class="mt-2 sm:mt-4 shrink-0 my-12">
           <h3 class="text-xs sm:text-sm uppercase tracking-wider text-stone-500 font-semibold mb-2 sm:mb-3 text-center">Presse & Artikel</h3>
           <div class="flex flex-col gap-1 sm:gap-2">
           {articles.map((article) => (
              <a href={article.url} target="_blank" rel="noopener noreferrer" 
                  class="group py-3 relative overflow-hidden w-full flex items-center p-2 sm:p-4 bg-white/60 hover:bg-white border border-stone-200/80 rounded-xl shadow-sm hover:shadow-md transition-all duration-300">
                   <span class="flex-shrink-0 w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center rounded-full bg-stone-100 text-stone-500 group-hover:bg-accent1/10 group-hover:text-accent1 transition-colors duration-300">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-4 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                      </svg>
                   </span>
                   <span class="flex-grow px-2 sm:px-3 text-xs sm:text-sm text-center text-stone-600 font-medium group-hover:text-accent1 transition-colors duration-300 leading-tight line-clamp-1">
                      {article.title}
                   </span>
              </a>
           ))}
           </div>
      </div>

    </div>

    <!-- Footer "Crafted with love" -->
    <div class="mt-2 sm:mt-12 text-center relative z-10 shrink-0">
      <p class="text-[10px] sm:text-xs text-stone-400 font-bonanova italic">
         Erleben sie die Pfalz und ihre Weine interaktiv.
      </p>
       <div class="flex items-center justify-center gap-1 mt-0.5 sm:mt-1 opacity-50">
           <span class="w-0.5 h-0.5 sm:w-1 sm:h-1 rounded-full bg-stone-300"></span>
           <span class="w-0.5 h-0.5 sm:w-1 sm:h-1 rounded-full bg-stone-300"></span>
           <span class="w-0.5 h-0.5 sm:w-1 sm:h-1 rounded-full bg-stone-300"></span>
       </div>
    </div>

  </div>
</div>

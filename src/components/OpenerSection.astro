---
import { Image } from 'astro:assets';
import WaterColorReveal from '@/components/WaterColorReveal.tsx';
import MjGrapesMosaicGlass from "@images/compressed/webP/compressed-mj-grapes-mosaicGlass.webp";
import GimmeldingenMap from "@images/GimmeldingenMap.jpg";

---
<!-- src/components/Tours.astro -->
<section class="overflow-hidden relative bg-white lg:pt-24 sm:pt-12">
  
  <div class="absolute top-0 left-0 z-0 w-full h-full pointer-events-none">
    <Image src={MjGrapesMosaicGlass} loading="lazy" fetchpriority="low" alt="Vineyard background" class="w-full h-full object-cover object-[50%_5%] scale-110 opacity-10 saturate-[0.5]" />
    <div class="absolute inset-0 bg-gradient-to-t from-white to-transparent via-white/80"></div>
    <div class="absolute w-full h-[200px] top-0 left-0 bg-gradient-to-b from-white via-white/80 to-transparent "></div>
  </div>
  

<div class="relative px-4 mx-auto -mt-20 mb-12 max-w-7xl sm:px-6 lg:px-8 md:mb-32">


  <!-- DESKTOP Opening Section: Center Piece -->
  <div class="hidden lg:block max-w-sm md:max-w-2xl md:mx-auto mt-12 md:my-24 translate-x-[12%] relative">
    <div class="w-[400px] h-[400px] absolute top-0 left-0 px-6 z-0 translate-y-[-20%] translate-x-[-45%]">
      <WaterColorReveal client:visible id="Opener-location-link-lg" width={300} height={300} 
      className="h-[40vh] aspect-square drop-shadow-[20px_20px_5px_rgba(0,0,0,0.07)] ">
      <div slot="child2" class="w-[400px] h-[400px] relative flex items-center justify-center ">
        <a href="http://www.gimmeldingen.de/unser-ort/portrait.html" class="relative mr-12 mb-44 w-fit h-fit">
          <p class="w-full h-full text-stone-700 
          backdrop-blur-sm bg-gradient-to-r from-stone-100/45 via-stone-200/30 to-stone-100/30
          text-sm md:text-[clamp(0.85rem,1.5vw,1.2rem)] font-bonanova font-light
          border-[1.5px] border-soft-beige/20 rounded-3xl px-2">
          <span class="text-transparent bg-clip-text bg-stone-700">📍</span>
          Gimmeldingen
            </p>
        </a>
      </div>
      <Image slot="child1" src={GimmeldingenMap} loading="lazy" fetchpriority="low" alt="Section 4" class="absolute object-contain scale-[1.5] brightness-[70%] contrast-[2] rotate-45 bottom-[0%] left-[0%] translate-x-[-10%] translate-y-[-20%] rounded-xl shadow-lg "  />
    </WaterColorReveal>
    </div>
    <div class="flex flex-col justify-center items-center text-lg text-gray-600 font-body">
      <h2 class="text-[44px] sm:text-5xl 2xl:text-7xl font-normal text-red-950/50 lowercase font-doulaise ">
        mittendrin statt nur dabei
      </h2>
      <div class="z-10 w-screen">
        <h3 class="w-full -mt-2 sm:-mt-12 2xl:-mt-[66px] text-center 
        text-[160px] font-extrabold font-bonanova tracking-tighter text-accent1 leading-snug ">
          Die Pfalz
        </h3>
      </div>
      <h2 class="font-bonanova font-extrabold text-text/50 text-3xl sm:text-[40px] xl:text-[47px] 2xl:text-[52px] leading-none -mt-8 sm:-mt-[45px] ">und ihre Weine</h2>
      <h2 class="font-bonanova font-extrabold text-text/40 text-3xl sm:text-[40px] xl:text-[43px] 2xl:text-[48px] leading-none -mt-2 sm:-mt-4">interaktiv erleben</h2>
    </div>
    </div>


    <!-- MOBILE (Tablet) Opening Section: Center Piece -->
  <div class="hidden md:block lg:hidden max-w-sm md:max-w-2xl md:mx-auto mt-12 md:my-24 translate-x-[12%] relative">
    <div class="w-[400px] h-[400px] absolute top-0 left-0 px-6 z-0 translate-y-[-10%] translate-x-[-35%]">
      <WaterColorReveal client:visible id="Opener-location-link-md" width={220} height={220} 
      className="h-[45vh] aspect-square drop-shadow-[20px_20px_5px_rgba(0,0,0,0.07)]">
      <div slot="child2" class="w-[400px] h-[400px] relative flex items-center justify-start ">
        <a href="http://www.gimmeldingen.de/unser-ort/portrait.html" class="relative mb-12 ml-16 w-fit h-fit">
          <p class="w-full h-full text-stone-700 
          backdrop-blur-sm bg-gradient-to-r from-stone-100/45 via-stone-200/30 to-stone-100/30
          text-sm md:text-[clamp(0.85rem,1.5vw,1.2rem)] font-bonanova font-light
          border-[1.5px] border-soft-beige/20 rounded-3xl px-2">
          <span class="text-transparent bg-clip-text bg-stone-700">📍</span>
          Gimmeldingen
            </p>
        </a>
      </div>
      <Image slot="child1" src={GimmeldingenMap} loading="lazy" fetchpriority="auto" decoding='async' alt="Section 4" class="absolute object-contain scale-[1.5] brightness-[70%] contrast-[2] rotate-45 bottom-[0%] left-[0%] translate-x-[-10%] translate-y-[-20%] rounded-xl shadow-lg "  /> 
    </WaterColorReveal>
    </div>
    <div class="flex flex-col justify-center items-center text-lg text-gray-600 font-body">
      <h2 class="text-[44px] sm:text-5xl 2xl:text-7xl font-normal text-red-950/50 lowercase font-doulaise ">
        mittendrin statt nur dabei
      </h2>
      <div class="z-10 w-screen">
        <h3 class="w-full -mt-2 sm:-mt-12 2xl:-mt-[66px] text-center 
        text-[120px]  font-extrabold font-bonanova tracking-tighter text-accent1 leading-snug ">
          Die Pfalz
        </h3>
      </div>
      <h2 class="font-bonanova font-extrabold text-text/50 text-3xl sm:text-[40px] 2xl:text-[47px] leading-none -mt-8 sm:-mt-[45px] ">und ihre Weine</h2>
      <h2 class="font-bonanova font-extrabold text-text/40 text-3xl sm:text-[40px] 2xl:text-[43px] leading-none -mt-2 sm:-mt-4">interaktiv erleben</h2>
    </div>
    </div>


    <!-- MOBILE (Mobile) Opening Section: Center Piece -->
  <div class="block relative mx-auto mt-12 md:hidden sm:max-w-md">
    <div class="w-full h-[200px] flex justify-center items-start rotate-0 pt-8 z-0">
      <WaterColorReveal client:visible id="Opener-location-link-sm" width={200} height={200} 
      className="h-[80vh] w-[200px] drop-shadow-[20px_20px_5px_rgba(0,0,0,0.07)] absolute bottom-0 right-0 z-0">
      <div slot="child2" class="w-[400px] h-[400px] relative flex items-center justify-start ">
        <a href="http://www.gimmeldingen.de/unser-ort/portrait.html" class="relative mb-44 ml-8 w-fit h-fit">
          <p class="w-full h-full text-stone-700 
          backdrop-blur-sm bg-gradient-to-r from-stone-100/45 via-stone-200/30 to-stone-100/30
          text-sm md:text-[clamp(0.85rem,1.5vw,1.2rem)] font-bonanova font-light
          border-[1.5px] border-soft-beige/20 rounded-3xl px-2">
          <span class="text-transparent bg-clip-text bg-stone-700">📍</span>
          Gimmeldingen
            </p>
        </a>
      </div>
      <Image slot="child1" src={GimmeldingenMap} loading="lazy" fetchpriority="auto" alt="Section 4" class="absolute object-contain scale-[1.5] brightness-[70%] contrast-[2] bottom-[0%] left-[0] translate-x-[0%] translate-y-[-20%] rounded-xl shadow-lg "  /> 
    </WaterColorReveal>
    </div>
    <div class="flex z-10 flex-col justify-center items-center text-lg text-gray-600 font-body">
      <h2 class="text-[40px] sm:text-5xl 2xl:text-7xl font-normal text-accent2-wine/90 lowercase font-doulaise z-20 ">
        mittendrin statt nur dabei
      </h2>
      <div class="z-10 w-screen">
        <h3 class="w-full -mt-6 sm:-mt-10 text-center 
        text-[78px] sm:text-[120px] 2xl:text-[160px] font-extrabold font-bonanova tracking-tighter text-accent1 leading-snug ">
          Die Pfalz
        </h3>
      </div>
      <h2 class="font-bonanova font-extrabold text-text/50 text-3xl sm:text-[40px] 2xl:text-[47px] leading-none -mt-8 sm:-mt-[45px] ">und ihre Weine</h2>
      <h2 class="font-bonanova font-extrabold text-text/40 text-3xl sm:text-[40px] 2xl:text-[43px] leading-none -mt-2 sm:-mt-4">interaktiv erleben</h2>
    </div>
    </div>

</div>
</section> 
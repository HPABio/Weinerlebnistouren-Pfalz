---
import { Image } from "astro:assets";
import HWELogoV2NoText from "@images/HWE-LogoV2-noText.svg";
import GimmeldingenMap from "@images/GimmeldingenMap.jpg";
---

<footer
  id="footer"
  class="overflow-hidden relative w-full bg-gradient-to-b from-white to-gray-50 border-t border-gray-200 h-fit">
  <Image
    src={GimmeldingenMap}
    alt="GimmeldingenMap"
    fetchpriority="low"
    loading="lazy"
    class="w-full h-full absolute top-[50%] translate-y-[-50%] left-0 object-cover object-center opacity-[1]"
  />
  <div
    class="absolute bottom-0 left-0 w-full h-[40vh] bg-gradient-to-t from-stone-300/80 via-stone-300/70 to-transparent">
  </div>
  <div
    class="relative inset-0 bg-gradient-to-b to-transparent from-slate-100/90 via-stone-100/60">
    <!-- Main Footer Content -->
    <div
      class="overflow-hidden relative px-4 py-12 mx-auto max-w-7xl sm:px-6 lg:px-8">
      <div
        class="hidden grid-cols-2 gap-y-14 gap-x-32 px-14 md:grid lg:grid-cols-3 md:gap-x-8 lg:px-0">
        <!-- Company Info -->
        <div
          class="flex flex-col row-start-1 justify-end items-start lg:col-span-1 lg:justify-between">
          <Image
            src={HWELogoV2NoText}
            alt="Weinerlebnistouren-Pfalz Logo"
            fetchpriority="low"
            loading="lazy"
            class="mr-3 w-auto h-12 sm:hidden"
          />
          <div class="flex items-center mb-4">
            <Image
              src={HWELogoV2NoText}
              alt="Weinerlebnistouren-Pfalz Logo"
              fetchpriority="low"
              loading="lazy"
              class="hidden mr-3 w-auto h-12 sm:block"
            />
            <div>
              <h3 class="text-lg font-semibold text-gray-900">
                Weinerlebnistouren-Pfalz
              </h3>
              <p class="text-sm text-gray-600">Geführte Wein-Erlebnistouren</p>
            </div>
          </div>
          <div class="flex flex-col justify-between">
            <p
              class="hidden mb-4 max-w-sm text-sm text-gray-600 sm:block lg:max-w-none">
              Entdecken Sie die Pfalz mit professionellen Wein-Erlebnistouren
              durch die schönsten Weinberge und Weingüter.
            </p>
            <div class="flex space-x-4">
              <a
                href="mailto:weinerlebnistouren.pfalz@gmail.com
"
                class="transition-colors text-accent1 hover:text-accent2-wine">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
                  ></path>
                  <path
                    d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
                  ></path>
                </svg>
              </a>
              <a
                href="tel:+491707110535"
                class="transition-colors text-accent1 hover:text-accent2-wine">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"
                  ></path>
                </svg>
              </a>
              <div class="flex items-center space-x-1">
                <p
                  class="transition-colors text-accent1 hover:text-accent2-wine">
                  Artikel 📰:
                </p>
                <a
                  href="https://www.rheinpfalz.de/lokal/neustadt_artikel,-zwische-mandel-und-könig-ludwig-erlebnisführung-in-gimmeldingen-_arid,5622874.html"
                  class="transition-colors text-text/40 hover:text-accent2-wine">
                  [<span class="text-accent1">1</span>]
                </a>
                <a
                  href="https://www.rheinpfalz.de/pfalzleben/pfalzgefuehl_artikel,-wein-erlebnistour-mandelblüte-meerspinne-monarchen-in-neustadt-gimmeldingen-_arid,5753081.html"
                  class="transition-colors text-text/40 hover:text-accent2-wine">
                  [<span class="text-accent1">2</span>]
                </a>
                <a
                  href="https://www.rheinpfalz.de/lokal/neustadt_artikel,-besondere-weinbergswanderung-mit-napoleon-durch-die-reben-_arid,5806456.html"
                  class="transition-colors text-text/40 hover:text-accent2-wine">
                  [<span class="text-accent1">3</span>]
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Navigation Links -->
        <div
          class="row-start-2 pt-0 mt-10 lg:col-span-1 md:row-start-1 sm:pt-4 md:pt-0 md:ml-14 sm:mt-0">
          <h3
            class="mb-2 text-base font-semibold text-gray-900 sm:text-lg sm:mb-4">
            Navigation
          </h3>
          <ul
            class="space-y-0 text-xs leading-snug lg:space-y-1 sm:leading-tight sm:text-sm">
            <li>
              <a
                href="/"
                class="text-gray-600 transition-colors hover:text-gray-900"
                >Startseite</a
              >
            </li>
            <li>
              <a
                href="/touren"
                class="text-gray-600 transition-colors hover:text-gray-900"
                >Touren</a
              >
            </li>
            <li>
              <a
                href="/gruppen"
                class="text-gray-600 transition-colors hover:text-gray-900"
                >Gruppen</a
              >
            </li>
            <li>
              <a
                href="/#about-me"
                class="text-gray-600 transition-colors hover:text-gray-900"
                >Über mich</a
              >
            </li>
            <li>
              <a
                href="/weingueter"
                class="text-gray-600 transition-colors hover:text-gray-900"
                >Weingüter</a
              >
            </li>
            <li>
              <a
                href="/presskit"
                class="text-gray-600 transition-colors hover:text-gray-900"
                >Presse & Media Kit</a
              >
            </li>
            <!-- <li><a href="/impressum" class="text-gray-600 transition-colors hover:text-gray-900">Impressum</a></li> -->
            <!-- <li><a href="/datenschutz" class="text-gray-600 transition-colors hover:text-gray-900">Datenschutz</a></li> -->
            <!-- <li><a href="/newsletter" class="text-gray-600 transition-colors  hover:text-gray-900">Newsletter</a></li> -->
            <!-- <li><a href="/barrierefreiheit" class="text-gray-600 transition-colors hover:text-gray-900">Erklärung zur Barrierefreiheit</a></li> -->
          </ul>
        </div>

        <!-- Collaborators -->
        <div class="row-start-2 mt-10 lg:col-span-1 md:row-start-1 sm:mt-0">
          <h3
            class="mb-2 text-base font-semibold text-gray-900 sm:text-lg sm:mb-4">
            Partner
          </h3>
          <ul
            class="space-y-0 text-xs leading-snug lg:space-y-1 sm:leading-tight sm:text-sm">
            <li>
              <a
                href="https://www.neustadt.eu/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-600 transition-colors hover:text-gray-900"
                >Tourist-Info Neustadt</a
              >
            </li>
            <li>
              <a
                href="http://www.gimmeldingen.de/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-600 transition-colors hover:text-gray-900"
                >Gimmeldingen</a
              >
            </li>
            <li>
              <a
                href="https://www.kultur-und-weinbotschafter.de/pfalz"
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-600 transition-colors hover:text-gray-900"
                >Kultur-und Weinbotschafter Pfalz</a
              >
            </li>
            <li>
              <a
                href="https://www.mandelbluete-pfalz.de/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-600 transition-colors hover:text-gray-900"
                >Pfälzer Mandelblüte</a
              >
            </li>
            <li>
              <a
                href="https://www.pfalz.de/de"
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-600 transition-colors hover:text-gray-900"
                >Zum Wohl die Pfalz</a
              >
            </li>
          </ul>
        </div>
      </div>

      <!-- MOBILE Contact Card Section -->
      <div
        id="get-in-touch-mobile"
        class="block md:hidden w-full max-w-[75%] sm:max-w-sm mx-auto relative z-10 mt-12 md:mt-16 mb-8">
        <div
          class="overflow-hidden relative p-6 bg-gradient-to-br rounded-xl border shadow-lg from-stone-50/85 to-stone-100/50 border-stone-200/50 md:p-8 md:pb-6">
          <!-- Background decoration -->
          <div class="absolute top-0 right-0 w-24 h-24 opacity-10">
            <svg viewBox="0 0 100 100" class="w-full h-full text-accent1/20">
              <path d="M50 0 L100 50 L50 100 L0 50 Z" fill="currentColor"
              ></path>
            </svg>
          </div>

          <div
            class="flex relative z-10 flex-col gap-6 justify-between lg:flex-row lg:items-end">
            <!-- Left side with button (2/3 width) -->
            <div
              class="flex-1 leading-tight text-center md:w-2/3 md:max-w- lg:w-2/3 md:text-left">
              <h3
                class="mb-8 font-bold tracking-tight text-left sm:text-xl font-bonanova sm:leading-none sm:mb-4">
                <span class="text-accent1/80"
                  >Sie haben noch <br class="block md:hidden" />offene Fragen?</span
                >
              </h3>
              <p
                class="max-w-44 sm:max-w-64 text-[12px] sm:text-sm text-left text-stone-600/50 sm:text-stone-600/70 font-normal mb-4 sm:mb-0 lg:mb-4 leading-relaxed sm:leading-snug">
                Ich helfe Ihnen <br class="block sm:hidden" /> gerne weiter <br
                /> und beantworte alle <br class="block sm:hidden" /> Ihre Fragen
                zu unseren <br />Wein-Erlebnistouren.
              </p>
              <div class="flex justify-center my-5 md:justify-start md:my-3">
                <a
                  href="/kontakt"
                  class="inline-flex items-center px-4 py-1 text-xs font-semibold text-white bg-gradient-to-r rounded-full shadow-lg transition-all duration-300 transform from-accent1 to-accent1/80 hover:from-accent1/90 hover:to-accent1/70 hover:scale-105 group">
                  <p>
                    Kontaktieren Sie mich <span class="hidden sm:inline"
                      >hier</span
                    >
                  </p>
                  <svg
                    class="ml-2 w-4 h-4 transition-transform duration-300 rotate-180 group-hover:translate-x-1"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>
          <p
            class="max-w-22 text-[10px] sm:text-xs sm:leading-tight mx-auto font-light text-gray-700/60 sm:text-gray-700 text-center w-full relative z-10">
            "Ich freue mich darauf, Sie auf eine meiner Touren mitzunehmen!"
          </p>
        </div>

        <div
          class="w-fit h-fit absolute top-0 right-[0%] translate-x-[15%] sm:translate-y-[-26%] md:translate-x-[-5%] md:translate-y-[-16%] lg:translate-x-[-20%] lg:translate-y-[-30%]">
          <Image
            src={HWELogoV2NoText}
            loading="lazy"
            fetchpriority="auto"
            alt="Vineyard background"
            class="relative w-[150px] md:w-[200px] object-cover opacity-85"
          />
        </div>
      </div>

      <div
        class="border-b border-gray-300 h-1 w-[70%] mx-auto mt-4 sm:mt-0 sm:my-8">
      </div>
      <!-- Bottom Section -->
      <div class="px-10 pt-8">
        <div class="flex flex-col justify-between items-center md:flex-row">
          <p
            class="mb-4 text-sm text-center text-gray-500 md:mb-0 md:text-left">
            &copy; 2025 Brigitta Heyl –<br class="md:hidden" /> Wein-Erlebnistouren-Pfalz
            <br class="sm:hidden" />| Alle Rechte vorbehalten | <br
              class="sm:hidden"
            /> Design by <a
              href="mailto:biocentra.info@gmail.com"
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors text-accent1 hover:text-gray-700"
              >Hendrik Cooper</a
            >
          </p>
          <div class="flex space-x-6">
            <a
              href="/kontakt"
              class="text-sm text-gray-500 transition-colors hover:text-gray-700"
              >Kontakt</a
            >
            <a
              href="/impressum"
              class="text-sm text-gray-500 transition-colors hover:text-gray-700"
              >Impressum</a
            >
            <a
              href="/datenschutz"
              class="text-sm text-gray-500 transition-colors hover:text-gray-700"
              >Datenschutz</a
            >
            <!-- <a href="/barrierefreiheit" class="text-sm text-gray-500 transition-colors  hover:text-gray-700">Barrierefreiheit</a> -->
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

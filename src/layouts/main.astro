---
import "@/styles/global.css";
import favicon from "@images/favicon.svg";
import CookieConsent from "@/components/CookieConsent.astro";

interface Props {
  content?: {
    title?: string;
    description?: string;
  };
}

const { content = {} } = Astro.props;
const title = content.title || "Weinerlebnistouren - Pfalz";
const description = content.description || "Weinerlebnistouren Pfalz - Entdecken Sie die Pfalz von ihrer schönsten Seite.";

// Absolute URLs are important for OpenGraph/Twitter cards.
import OgImage from "@images/HWE-LogoV2.png";
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const ogImageUrl = Astro.site ? new URL(OgImage.src, Astro.site).href : OgImage.src;
---

<html lang="de">
  <head>
    <link rel="stylesheet" type="text/css" href="https://pretix.weinerlebnistouren-pfalz.de/weintouren/tickets/widget/v2.css" crossorigin="anonymous">
<script is:inline type="text/javascript" src="https://pretix.weinerlebnistouren-pfalz.de/widget/v2.de.js" async crossorigin="anonymous"></script>
    <!-- Ensure apex domain always redirects to canonical www host (fixes split deployment / broken asset refs on apex) -->
    <!-- <script is:inline>
      (() => {
        if (typeof window === "undefined") return;
        const canonicalHost = "www.weinerlebnistouren-pfalz.de";
        const apexHost = "weinerlebnistouren-pfalz.de";
        if (window.location.hostname === apexHost) {
          window.location.replace(
            `https://${canonicalHost}${window.location.pathname}${window.location.search}${window.location.hash}`
          );
        }
      })();
    </script>

    <link
      rel="canonical"
      href={`https://www.weinerlebnistouren-pfalz.de${Astro.url.pathname}`}
    /> -->

    {!import.meta.env.DEV && (
        <script
          is:inline
          async
          src="https://www.googletagmanager.com/gtag/js?id=G-G6LFB82PZ9"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag("js", new Date());


          gtag("consent", "default", {
            ad_storage: "denied",
            ad_user_data: "denied",
            ad_personalization: "denied",
            analytics_storage: "denied",
          });

          gtag("config", "G-G6LFB82PZ9");
        </script>
    )}


    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={favicon.src}
      fetchpriority="high"
    />
      <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- OpenGraph -->
    <meta property="og:site_name" content="Weinerlebnistouren Pfalz" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Weinerlebnistouren Pfalz Logo" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={OgImage.width.toString()} />
    <meta property="og:image:height" content={OgImage.height.toString()} />
    <link
      href="https://fonts.googleapis.com/css2?family=Ballet:opsz@16..72&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Bona+Nova+SC:ital,wght@0,400;0,700;1,400&family=Caveat:wght@400..700&family=DM+Serif+Display:ital@0;1&family=DM+Serif+Text:ital@0;1&family=Gloock&family=Indie+Flower&family=Lusitana:wght@400;700&family=Monsieur+La+Doulaise&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <CookieConsent />
  </body>
</html>

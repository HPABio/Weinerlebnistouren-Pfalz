---
/* src/pages/index.astro */
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Grainy Gradient</title>
  </head>

  <body class="min-h-screen grain-bg">
    <main class="min-h-screen grid place-items-center">
      <div class="h-16 w-16 rounded-full bg-black/90"></div>
    </main>

    <style is:global>
      /* Tailwind-friendly background + grain overlay */
      .grain-bg {
        /* vignette + main gradient */
        background:
          radial-gradient(circle at 30% 70%, rgba(0,0,0,0.06), transparent 60%),
          linear-gradient(135deg, #e6e6e6 0%, #dfe7b5 35%, #d8ef6a 70%, #e6ff5c 100%);
        position: relative;
        overflow: hidden;
      }

      .grain-bg::after {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        mix-blend-mode: soft-light;

        /* Adjust pixelation here:
           - smaller width/height => more pixelated
           - lower baseFrequency  => chunkier noise
        */
        background-image: url("data:image/svg+xml;utf8,\
<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'>\
<filter id='n'>\
<feTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4'/>\
</filter>\
<rect width='100%25' height='100%25' filter='url(%23n)' opacity='0.06'/>\
</svg>");
      }
    </style>
  </body>
</html>